import { ComponentMetrics } from "metrics.slint";
import { Theme, Typography, Spacing, Shape } from "../foundations/foundations.slint";
import { LayoutState } from "../states/layout-state.slint";
import { PluginState } from "../states/plugin-state.slint";
import { PluginListState } from "../states/plugin-list-state.slint";
import { IconButton, Control } from "../controls/button.slint";
import { Icons } from "../icons/icons.slint";
import { UiText } from "../primitives/text.slint";
import { Surface } from "../primitives/surface.slint";

struct SidebarItem { id: string, title: string, icon: image, active: bool }

component SidebarButton inherits IconButton {

}

export component Sidebar inherits Surface {
    level: panel;
    width: ComponentMetrics.sidebar-w;
    property <[SidebarItem]> items: [
        { id: "repl", title: "Command line", icon: Icons.terminal, active: LayoutState.repl-visible },
        { id: "objects", title: "Objects", icon: Icons.list-tree, active: LayoutState.objects-visible },
        { id: "selections", title: "Selections", icon: Icons.layers, active: LayoutState.selections-visible },
        { id: "recent-atoms", title: "Recent atoms", icon: Icons.crosshair, active: LayoutState.recent-atoms-visible },
        { id: "sequence", title: "Sequence", icon: Icons.text-cursor-input, active: LayoutState.sequence-visible },
        { id: "movie", title: "Movie", icon: Icons.clapperboard, active: LayoutState.movie-visible }
    ];
    top := VerticalLayout {
        x: Spacing.sm; y: Spacing.md;
        spacing: Spacing.sm;
        for item in root.items: SidebarButton {
            label: item.title; icon: item.icon;
            enabled: !LayoutState.empty-mode;
            active: !LayoutState.empty-mode && item.active;
            clicked => {
                if item.active { LayoutState.hide-panel(item.id); }
                else { LayoutState.show-panel(item.id); }
            }
        }
    }
    separator := Rectangle {
        x: Spacing.sm;
        y: top.y + top.preferred-height + Spacing.md;
        width: parent.width - 2 * Spacing.sm;
        height: Shape.hairline;
        background: Theme.border-subtle;
    }
    // Plugin-provided labels remain dynamic; no assumptions about plugin glyphs.
    Flickable {
        x: Spacing.sm;
        y: separator.y + Spacing.md;
        width: ComponentMetrics.icon-size;
        height: max(0px, bottom.y - self.y - Spacing.md);
        content-height: plugin-buttons.preferred-height;
        plugin-buttons := VerticalLayout {
            spacing: Spacing.sm;
            for item in PluginState.toolbar-items: Control {
                width: ComponentMetrics.icon-size;
                label: item.title;
                tooltip: item.title;
                active: item.active;
                clicked => { PluginState.toggle-panel(item.id); }
                UiText {
                    width: parent.width; height: parent.height;
                    text: item.icon; text-style: Typography.hint;
                    color: item.active ? Theme.accent-primary : Theme.text-secondary;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }
    bottom := VerticalLayout {
        x: Spacing.sm;
        y: parent.height - self.preferred-height - Spacing.md;
        spacing: Spacing.sm;
        SidebarButton {
            label: "Switch theme"; icon: Icons.contrast;
            active: !Theme.dark-mode;
            clicked => { Theme.toggle-theme(); }
        }
        SidebarButton {
            label: "Plugins"; icon: Icons.puzzle;
            clicked => { PluginListState.open(); }
        }
    }
}
