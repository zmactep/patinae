import { Typography, Spacing, Shape } from "../foundations/foundations.slint";
// Application component geometry; not part of the Foundations scale.
export struct SequenceMetrics {
    cell: length, label: length, offset: length, padding: length,
    height: length, ruler: length, font: length, small-font: length,
    letter-baseline: length, ruler-baseline: length,
}
export global ComponentMetrics {
    out property <length> section-header-h: Typography.label.size + 2 * Spacing.sm;
