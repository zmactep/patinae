import { ComponentMetrics } from "../metrics.slint";
import { IconButton } from "../../controls/button.slint";
import { Icons } from "../../icons/icons.slint";
import { ObjectsState } from "../../states/objects-state.slint";

// The action ID is a command-routing contract, not the displayed glyph.

component RowBtn inherits IconButton {
    in property <string> action-id;
    icon: root.action-id == "R" ? Icons.representation : Icons.color;
    in property <string> source: "object";   // "object" | "selection"
    in property <string> obj-name;
    in property <string> chain-id: "";
    in property <string> subchain-label: "";
    in property <string> subchain-kind: "";
    in property <int> entry-index: -1;
    in property <string> selector-clause: "";
    in property <bool> row-hovered: false;
    in property <bool> sibling-hovered: false;
    active: ObjectsState.popover-kind == root.action-id
        && ObjectsState.popover-source == root.source
        && ObjectsState.popover-obj-name == root.obj-name
        && ObjectsState.popover-chain-id == root.chain-id
        && ObjectsState.popover-subchain-label == root.subchain-label;
    // Any popover is open for this row
    property <bool> row-popover-open: ObjectsState.popover-kind != ""
        && ObjectsState.popover-source == root.source
        && ObjectsState.popover-obj-name == root.obj-name
        && ObjectsState.popover-chain-id == root.chain-id
        && ObjectsState.popover-subchain-label == root.subchain-label;
    changed absolute-position => {
        if root.active { ObjectsState.popover-anchor-y = root.absolute-position.y + root.height; }
    }
    label: root.action-id == "R" ? "Representations" : "Colors";
    clicked => { root.activate(); }
    function activate() {
        ObjectsState.popover-anchor-y = root.absolute-position.y + root.height;
        ObjectsState.row-btn-clicked(root.action-id, root.source, root.obj-name, root.chain-id, root.subchain-label, root.subchain-kind, root.entry-index, root.selector-clause);
    }
    // Hovering another row's action can switch the card in one click.
    property <bool> shown: root.row-popover-open
        || root.row-hovered || root.hovered || root.focused || root.sibling-hovered;

    width: ComponentMetrics.row-btn-w;
    height: ComponentMetrics.row-btn-h;
    opacity: root.shown ? 1.0 : 0.0;

}

export component RowActions inherits Rectangle {
    in property <string> source: "object";
    in property <string> obj-name;
    in property <string> chain-id;
    in property <string> subchain-label;
    in property <string> subchain-kind;
    in property <int> entry-index: -1;
    in property <string> selector-clause;
    in property <bool> row-hovered;
    in property <bool> representations: true;
    in property <bool> colors: true;
    width: ComponentMetrics.row-actions-w;
    height: ComponentMetrics.row-btn-h;
    HorizontalLayout {
        padding-left: ComponentMetrics.row-btn-group-pad;
        padding-right: ComponentMetrics.row-btn-group-pad;
        spacing: ComponentMetrics.row-btn-spacing;
        representation := RowBtn {
            action-id: "R"; visible: root.representations;
            source: root.source; obj-name: root.obj-name; chain-id: root.chain-id;
            subchain-label: root.subchain-label; subchain-kind: root.subchain-kind;
            entry-index: root.entry-index; selector-clause: root.selector-clause;
            row-hovered: root.row-hovered; sibling-hovered: color.hovered;
        }
        color := RowBtn {
            action-id: "C"; visible: root.colors;
            source: root.source; obj-name: root.obj-name; chain-id: root.chain-id;
            subchain-label: root.subchain-label; subchain-kind: root.subchain-kind;
            entry-index: root.entry-index; selector-clause: root.selector-clause;
            row-hovered: root.row-hovered; sibling-hovered: representation.hovered;
        }
    }
}
