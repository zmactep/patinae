import { ComponentMetrics } from "../metrics.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { ObjectsState, SelectionRow } from "../../states/objects-state.slint";
import { RowBtn } from "./row-btn.slint";

// ── Selection section header ─────────────────────────────────────────

component SelectionHeader inherits Rectangle {
    height: ComponentMetrics.tab-bar-h;
    background: transparent;

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        alignment: space-between;

        HorizontalLayout {
            spacing: Spacing.sm;
            alignment: start;

            Text {
                text: "SELECTIONS";
                color: Theme.accent-selection;
                font-size: Typography.compact-label.size;
                font-weight: 500;
                letter-spacing: 1.1px;
                vertical-alignment: center;
            }

            Text {
                text: ObjectsState.selections.length;
                color: Theme.text-placeholder;
                font-size: Typography.compact-label.size;
                vertical-alignment: center;
            }
        }

        // Placeholder for creating a saved selection from the panel.
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: ComponentMetrics.row-btn-w;
                height: ComponentMetrics.row-btn-h;
                border-radius: Shape.radius-sm;

                Text {
                    text: "+";
                    color: Theme.text-disabled;
                    font-size: Typography.body.size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ta := TouchArea {}

                states [
                    hover when ta.has-hover: {
                        background: Theme.surface-control;
                    }
                ]
            }
        }
    }
}

// ── Selection row ────────────────────────────────────────────────────

component SelectionRowItem inherits Rectangle {
    in property <SelectionRow> data;

    property <bool> click-shift: false;
    property <bool> click-meta:  false;

    height: ComponentMetrics.row-h;
    border-radius: Shape.radius-md;
    background: root.data.selected
        ? Theme.accent-primary.with-alpha(0.06)
        : touch.has-hover
            ? Theme.surface-control.with-alpha(0.5)
            : transparent;
    border-width: root.data.selected ? Shape.hairline : 0px;
    border-color: root.data.selected
        ? Theme.accent-primary.with-alpha(0.5)
        : transparent;
    accessible-role: list-item;
    accessible-label: root.data.name + ", " + root.data.atom-count + " atoms";

    // Name in parentheses, magenta
    Text {
        x: Spacing.md + ComponentMetrics.chevron-w + Spacing.sm;
        y: 0;
        width: parent.width - self.x - 2 * ComponentMetrics.row-h - Spacing.sm;
        height: parent.height;
        text: "(" + root.data.name + ")";
        color: root.data.enabled ? Theme.accent-selection : Theme.text-placeholder;
        font-size: Typography.compact-body.size;
        vertical-alignment: center;
        overflow: elide;
    }

    // Atom count (fades out when R/C buttons visible)
    Text {
        x: parent.width - self.width - Spacing.md - 2 * ComponentMetrics.row-h;
        y: 0;
        height: parent.height;
        text: root.data.atom-count;
        color: Theme.text-placeholder;
        font-size: Typography.hint.size;
        vertical-alignment: center;
        opacity: touch.has-hover ? 0.0 : 1.0;
        visible: root.data.atom-count > 0;
    }

    // Click area (before RowBtns so it doesn't steal clicks)
    touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 2 * ComponentMetrics.row-h;
        height: parent.height;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.click-shift = event.modifiers.shift;
                root.click-meta  = event.modifiers.meta || event.modifiers.control;
                if (event.button == PointerEventButton.right) {
                    ObjectsState.selection-right-clicked(root.data.name);
                }
            }
        }
        clicked => {
            ObjectsState.selection-clicked(root.data.name,
                                           root.click-shift, root.click-meta);
        }
    }

    // R button (representations)
    r-btn := RowBtn {
        x: parent.width - 2 * ComponentMetrics.row-h + 4px;
        y: (parent.height - self.height) / 2;
        letter: "R";
        source: "selection";
        obj-name: root.data.name;
        row-hovered: touch.has-hover;
        sibling-hovered: c-btn.hovered;
    }

    // C button (color)
    c-btn := RowBtn {
        x: parent.width - ComponentMetrics.row-h + 2px;
        y: (parent.height - self.height) / 2;
        letter: "C";
        source: "selection";
        obj-name: root.data.name;
        row-hovered: touch.has-hover;
        sibling-hovered: r-btn.hovered;
    }
}

component SelectionRowsList inherits Rectangle {
    Flickable {
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { ObjectsState.selection-list-background-clicked(); }
        }

        VerticalLayout {
            for item in ObjectsState.selections: Rectangle {
                height: ComponentMetrics.row-h + ComponentMetrics.row-gap;

                SelectionRowItem {
                    x: Spacing.xs;
                    width: parent.width - 2 * Spacing.xs;
                    data: item;
                }
            }
        }
    }
}

export component SelectionList inherits Rectangle {
    TouchArea {
        clicked => { ObjectsState.selection-list-background-clicked(); }
    }

    VerticalLayout {
        width: root.width;

        SelectionHeader {}

        if ObjectsState.selections.length == 0: Text {
            text: "no selections yet";
            color: Theme.text-placeholder;
            font-size: Typography.hint.size;
            letter-spacing: 0.6px;
            horizontal-alignment: left;
            vertical-alignment: top;
            x: Spacing.md;
        }

        if ObjectsState.selections.length > 0: SelectionRowsList {
            vertical-stretch: 1;
        }
    }
}
