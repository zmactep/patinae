import { InlineName } from "../../controls/inline-name.slint";
import { UiText } from "../../primitives/text.slint";
import { ComponentMetrics } from "../metrics.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { ObjectsState, SelectionRow } from "../../states/objects-state.slint";
import { RowActions } from "./row-btn.slint";


import { PanelRow } from "../../controls/panel-row.slint";
import { TooltipAnchor } from "../../controls/tooltip.slint";
export component SelectionRowItem inherits PanelRow {
    in property <SelectionRow> data;

    property <bool> click-shift: false;
    property <bool> click-meta:  false;

    height: ComponentMetrics.row-h;
    selected: root.data.selected;
    hovered: touch.has-hover;
    accessible-role: list-item;
    accessible-label: root.data.name + ", " + root.data.atom-count + " atoms";

    activated(shift, meta) => { ObjectsState.selection-clicked(root.data.name, shift, meta); }
    // Name in parentheses, magenta
    name-text := UiText {
        x: Spacing.md + ComponentMetrics.chevron-w + Spacing.sm;
        y: 0;
        width: max(0px, atom-count.x - self.x - Spacing.sm);
        height: parent.height;
        text: "(" + root.data.name + ")";
        color: root.data.enabled ? Theme.accent-selection : Theme.text-placeholder;
        text-style: Typography.body-small;
        vertical-alignment: center;
        overflow: elide;
    }



    // Count occupies a stable column; actions never shift the row content.
    atom-count := UiText {
        x: parent.width - self.width - Spacing.md - ComponentMetrics.row-actions-w;
        y: 0;
        height: parent.height;
        text: root.data.atom-count;
        color: Theme.text-placeholder;
        text-style: Typography.hint;
        vertical-alignment: center;

        visible: root.data.atom-count > 0;
    }

    // Click area (before RowBtns so it doesn't steal clicks)
    touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - ComponentMetrics.row-actions-w;
        height: parent.height;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.click-shift = event.modifiers.shift;
                root.click-meta  = event.modifiers.meta || event.modifiers.control;
                if (event.button == PointerEventButton.right) {
                    ObjectsState.selection-right-clicked(root.data.name);
                }
            }
        }
        clicked => {
            root.focus-row();
            ObjectsState.selection-clicked(root.data.name,
                                           root.click-shift, root.click-meta);
        }
    }

    RowActions {
        x: parent.width - self.width; y: (parent.height - self.height) / 2;
        source: "selection"; obj-name: root.data.name;
        row-hovered: touch.has-hover || root.focused;
    }
    TooltipAnchor { width: parent.width - ComponentMetrics.row-actions-w; height: parent.height; text: root.data.name; active: touch.has-hover; }
    if ObjectsState.name-input-action == "rename" && ObjectsState.name-input-target == root.data.name: InlineName {
        x: name-text.x; y: name-text.y; width: name-text.width; height: name-text.height;
    }
}