import { Control, IconTile } from "../../controls/button.slint";
import { UiIcon } from "../../primitives/icon.slint";
import { TooltipAnchor } from "../../controls/tooltip.slint";
import { TooltipState } from "../../states/tooltip-state.slint";
import { Representations } from "../../icons/representations.slint";
import { UiText } from "../../primitives/text.slint";
import { SectionLabel } from "../../primitives/section-label.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { ObjectsState } from "../../states/objects-state.slint";

// ── Section label ──────────────────────────────────────────────────



// ── Scheme card ────────────────────────────────────────────────────

component SchemeCard inherits Rectangle {
    in property <string> scheme-id;
    in property <string> label;
    in property <string> cmd-text;
    in property <bool> disabled: false;
    in property <color> ic1: transparent;
    in property <color> ic2: transparent;
    in property <color> ic3: transparent;
    in property <color> ic4: transparent;
    in property <bool> has-ic4: false;
    in property <bool> dots: false;       // circles instead of squares
    in property <bool> has-custom-icon: false;

    height: 42px;
    preferred-width: 0px;
    min-width: 0px;
    border-radius: Shape.radius-sm;
    border-width: Shape.hairline;
    border-color: root.disabled ? Theme.border-subtle
        : card-touch.has-hover ? Theme.border-strong : Theme.border-subtle;
    background: root.disabled ? transparent
        : card-touch.has-hover ? Theme.surface-control : Theme.surface-raised;
    opacity: root.disabled ? 0.4 : 1.0;

    // Default icons — hidden when custom icon is used
    property <length> icon-count-width: root.has-ic4 ? 38px : 28px;
    Rectangle {
        visible: !root.has-custom-icon;
        x: (parent.width - root.icon-count-width) / 2;
        y: 8px;
        width: root.icon-count-width;
        height: 8px;

        Rectangle { x: 0px;  width: 8px; height: 8px; border-radius: root.dots ? 4px : 2px; background: root.ic1; }
        Rectangle { x: 10px; width: 8px; height: 8px; border-radius: root.dots ? 4px : 2px; background: root.ic2; }
        Rectangle { x: 20px; width: 8px; height: 8px; border-radius: root.dots ? 4px : 2px; background: root.ic3; }
        Rectangle { x: 30px; width: 8px; height: 8px; border-radius: root.dots ? 4px : 2px; background: root.ic4;
                    visible: root.has-ic4; }
    }

    // Custom icon area
    Rectangle {
        y: 4px;
        width: 100%;
        height: 14px;
        @children
    }

    UiText {
        y: 20px;
        width: 100%;
        height: 18px;
        text: root.label;
        color: root.disabled ? Theme.text-placeholder
            : card-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        text-style: Typography.hint;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    card-touch := TouchArea {
        enabled: !root.disabled;
        changed has-hover => {
            if self.has-hover {
                ObjectsState.popover-cmd-preview = root.cmd-text;
            }
        }
        clicked => {
            ObjectsState.popover-execute();
        }
    }
}

// ── Color swatch ───────────────────────────────────────────────────

component ColorSwatch inherits Rectangle {
    in property <string> color-name;
    in property <color> swatch-color;
    in property <string> cmd-text;

    horizontal-stretch: 1;
    height: self.width;
    border-radius: 4px;
    background: root.swatch-color;
    border-width: swatch-touch.has-hover ? 1.5px : 0px;
    border-color: Theme.text-primary;

    swatch-touch := TouchArea {
        changed has-hover => {
            if self.has-hover {
                ObjectsState.popover-cmd-preview = root.cmd-text;
            }
        }
        clicked => {
            ObjectsState.popover-execute();
        }
    }
}

// ── Scope button ───────────────────────────────────────────────────

component ScopeButton inherits Rectangle {
    in property <string> scope-id;
    in property <string> label;
    in property <string> tooltip;
    in property <bool> disabled: false;

    property <bool> active: !root.disabled && ObjectsState.popover-scope == root.scope-id;

    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    height: 22px;
    border-radius: Shape.radius-sm;
    border-width: root.active ? 1px : Shape.hairline;
    border-color: root.disabled ? Theme.border-subtle
        : root.active ? Theme.accent-primary
        : scope-touch.has-hover ? Theme.border-strong : Theme.border-subtle;
    background: root.disabled ? transparent
        : root.active ? Theme.accent-primary.with-alpha(0.12)
        : scope-touch.has-hover ? Theme.surface-control : Theme.surface-raised;
    opacity: root.disabled ? 0.4 : 1.0;

    UiText {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.disabled ? Theme.text-placeholder
            : root.active ? Theme.accent-primary
            : scope-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        text-style: Typography.hint;
        font-weight: root.active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TooltipAnchor {
        width: parent.width;
        height: parent.height;
        text: root.tooltip;
        active: root.visible && !root.disabled && scope-touch.has-hover && !scope-touch.pressed;
    }

    scope-touch := TouchArea {
        enabled: !root.disabled;
        clicked => {
            TooltipState.dismiss();
            ObjectsState.popover-scope = root.scope-id;
        }
    }
}

// ── Scope icon button (rep-toggle style + scope behavior) ─────────

component ScopeIconButton inherits Rectangle {
    in property <string> scope-id;
    in property <string> label;
    in property <image> icon;
    in property <bool> disabled;
    in property <bool> has-color;
    in property <string> setting-name;
    property <string> reset-command: "unset " + root.setting-name + ", " + ObjectsState.popover-target;
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    height: tile.height;

    tile := IconTile {
        width: parent.width;
        enabled: !root.disabled;
        label: root.label;
        icon: root.icon;
        active: self.enabled && ObjectsState.popover-scope == root.scope-id;
        clicked => { ObjectsState.popover-scope = root.scope-id; }
    }

    // A sibling above the tile keeps reset clicks out of its scope handler.
    if root.has-color: Control {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        label: "Reset " + root.label + " color";
        tooltip: root.reset-command;
        changed hovered => {
            if self.hovered {
                ObjectsState.popover-cmd-preview = root.reset-command;
            }
        }
        clicked => {
            ObjectsState.popover-cmd-preview = root.reset-command;
            ObjectsState.popover-execute();
        }
        UiIcon {
            x: 4px;
            y: 4px;
            width: 8px;
            height: 8px;
            source: @image-url("../../icons/lucide/x.svg");
            tint: parent.tint;
        }
    }
}

// ── Color popover ──────────────────────────────────────────────────

export component ColorPopover inherits Rectangle {
    height: inner.preferred-height;
    border-radius: Shape.radius-md;
    background: Theme.surface-overlay;
    border-width: Shape.hairline;
    border-color: Theme.border-subtle;

    // Block empty-surface clicks from falling through to the dismiss backdrop.
    TouchArea {}

    property <bool> solid-only: ObjectsState.popover-solid-only;
    property <string> target: !root.solid-only && ObjectsState.popover-scope == "all-c"
        ? ObjectsState.popover-target + " and elem C"
        : ObjectsState.popover-target;
    property <string> scope: ObjectsState.popover-scope;
    // True when the popover targets a biopolymer or organic subchain (or object-level).
    property <bool> is-bio-or-organic: ObjectsState.popover-subchain-kind == ""
        || ObjectsState.popover-subchain-kind == "biopolymer"
        || ObjectsState.popover-subchain-kind == "organic";
    // True only for biopolymer subchains (or object-level).
    property <bool> is-bio: ObjectsState.popover-subchain-kind == ""
        || ObjectsState.popover-subchain-kind == "biopolymer";
    // Command prefix based on scope
    property <string> scope-prefix: root.solid-only ? "color "
        : root.scope == "all" || root.scope == "all-c" ? "color "
        : root.scope == "cartoon" ? "set cartoon_color, "
        : root.scope == "sticks" ? "set stick_color, "
        : root.scope == "lines" ? "set line_color, "
        : root.scope == "spheres" ? "set sphere_color, "
        : root.scope == "surface" ? "set surface_color, "
        : root.scope == "mesh" ? "set mesh_color, "
        : root.scope == "dots" ? "set dot_color, "
        : root.scope == "ribbon" ? "set ribbon_color, "
        : "color ";

    inner := VerticalLayout {
        padding: Spacing.sm;
        spacing: Spacing.sm;

        // Header
        HorizontalLayout {
            alignment: space-between;
            height: 18px;
            padding-left: Spacing.xs;
            padding-right: Spacing.xs;

            UiText {
                text: "COLOR";
                color: Theme.text-muted;
                text-style: Typography.hud;
                font-weight: 500;
                letter-spacing: 1.1px;
                vertical-alignment: center;
            }

            UiText {
                text: ObjectsState.popover-display-label;
                color: Theme.text-placeholder;
                text-style: Typography.hud;
                vertical-alignment: center;
            }
        }

        // ── SCOPE ──
        if !root.solid-only: SectionLabel { text: "SCOPE"; }

        if !root.solid-only: VerticalLayout {
            spacing: 2px;

            HorizontalLayout {
                spacing: 1px;
                ScopeButton {
                    scope-id: "all";
                    label: "base";
                    tooltip: "Base color of all atoms. Explicit representation colors take priority.";
                }
                ScopeButton {
                    scope-id: "all-c";
                    label: "base C";
                    tooltip: "Base color of carbon atoms only. Explicit representation colors take priority.";
                    disabled: !root.is-bio-or-organic;
                }
            }

            for row in 2: HorizontalLayout {
                spacing: Spacing.xs;
                for column in 4: ScopeIconButton {
                    property <int> index: row * 4 + column;
                    scope-id: Representations.items[self.index].id;
                    label: Representations.items[self.index].label;
                    icon: Representations.items[self.index].icon;
                    disabled: Representations.items[self.index].biopolymer && !root.is-bio;
                    has-color: self.scope-id == "lines" ? ObjectsState.popover-color-lines
                        : self.scope-id == "sticks" ? ObjectsState.popover-color-sticks
                        : self.scope-id == "spheres" ? ObjectsState.popover-color-spheres
                        : self.scope-id == "cartoon" ? ObjectsState.popover-color-cartoon
                        : self.scope-id == "ribbon" ? ObjectsState.popover-color-ribbon
                        : self.scope-id == "surface" ? ObjectsState.popover-color-surface
                        : self.scope-id == "mesh" ? ObjectsState.popover-color-mesh
                        : ObjectsState.popover-color-dots;
                    setting-name: self.scope-id == "lines" ? "line_color"
                        : self.scope-id == "sticks" ? "stick_color"
                        : self.scope-id == "spheres" ? "sphere_color"
                        : self.scope-id == "dots" ? "dot_color"
                        : self.scope-id + "_color";
                }
            }
        }

        // Separator
        if !root.solid-only: Rectangle {
            height: Shape.hairline;
            background: Theme.border-subtle;
        }

        // ── SOLID ──
        SectionLabel { text: "SOLID"; }

        VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 4px;
                for entry in Theme.solid-row1: ColorSwatch {
                    color-name: entry.name;
                    swatch-color: entry.swatch;
                    cmd-text: root.scope-prefix + entry.name + ", " + root.target;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                for entry in Theme.solid-row2: ColorSwatch {
                    color-name: entry.name;
                    swatch-color: entry.swatch;
                    cmd-text: root.scope-prefix + entry.name + ", " + root.target;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                for entry in Theme.solid-row3: ColorSwatch {
                    color-name: entry.name;
                    swatch-color: entry.swatch;
                    cmd-text: root.scope-prefix + entry.name + ", " + root.target;
                }
            }
        }

        // Separator
        Rectangle {
            height: Shape.hairline;
            background: Theme.border-subtle;
        }

        // ── SCHEME ──
        if !root.solid-only: SectionLabel { text: "SCHEME"; }

        if !root.solid-only: VerticalLayout {
            spacing: 2px;

            HorizontalLayout {
                spacing: 2px;
                SchemeCard {
                    scheme-id: "chain";
                    label: "by chain";
                    horizontal-stretch: 1;
                    cmd-text: root.scope-prefix + "chain, " + root.target;
                    disabled: ObjectsState.popover-chain-id != "" || !root.is-bio;
                    ic1: Theme.chain-a; ic2: Theme.chain-b; ic3: Theme.chain-c;
                }

                SchemeCard {
                    scheme-id: "ss";
                    label: "by ss";
                    horizontal-stretch: 1;
                    cmd-text: root.scope-prefix + "ss, " + root.target;
                    disabled: !root.is-bio;
                    has-custom-icon: true;

                    // Helix – loop – strand arrow
                    Rectangle {
                        x: (parent.width - 38px) / 2;
                        width: 38px;
                        height: 8px;

                        // Helix wave (magenta) — smooth sine
                        Path {
                            x: 0px; y: 0px;
                            width: 12px; height: 8px;
                            commands: "M 0 5 Q 3 -1, 6 4 Q 9 9, 12 3";
                            stroke: Theme.ss-helix;
                            stroke-width: 1.5px;
                        }

                        // Loop dash (grey)
                        Rectangle {
                            x: 14px; y: 3px;
                            width: 10px; height: 1.5px;
                            background: Theme.ss-loop;
                            border-radius: 0.75px;
                        }

                        // Strand arrow body (amber)
                        Rectangle {
                            x: 26px; y: 2.5px;
                            width: 8px; height: 3px;
                            background: Theme.ss-sheet;
                            border-radius: 0.5px;
                        }

                        // Strand arrow head (amber)
                        Path {
                            x: 33px; y: 0px;
                            width: 5px; height: 8px;
                            commands: "M 0 0 L 5 4 L 0 8 Z";
                            fill: Theme.ss-sheet;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 2px;
                SchemeCard {
                    scheme-id: "element";
                    label: "by element";
                    horizontal-stretch: 1;
                    cmd-text: root.scope-prefix + "atomic, " + root.target;
                    has-custom-icon: true;

                    // Alanine: N — Cα(—Cβ) — C'(=O)(—O)
                    // Bonds drawn first, atoms on top cover bond endpoints
                    Rectangle {
                        x: (parent.width - 28px) / 2;
                        width: 28px;
                        height: 14px;

                        // ── Bonds (1px) ──
                        Rectangle { x: 4px;  y: 7.5px; width: 4px; height: 1px; background: Theme.text-muted; }  // N—Cα
                        Rectangle { x: 12px; y: 7.5px; width: 4px; height: 1px; background: Theme.text-muted; }  // Cα—C'
                        Rectangle { x: 20px; y: 7.5px; width: 4px; height: 1px; background: Theme.text-muted; }  // C'—O right
                        Rectangle { x: 9.5px; y: 9px;  width: 1px; height: 2px; background: Theme.text-muted; }  // Cα—Cβ
                        Rectangle { x: 17px; y: 4px;   width: 1px; height: 2px; background: Theme.text-muted; }  // C'=O line 1
                        Rectangle { x: 18px; y: 4px;   width: 1px; height: 2px; background: Theme.text-muted; }  // C'=O line 2

                        // ── Atoms (all 4×4) ──
                        Rectangle { x: 0px;  y: 6px; width: 4px; height: 4px; border-radius: 2px; background: #617ED8; }  // N
                        Rectangle { x: 8px;  y: 6px; width: 4px; height: 4px; border-radius: 2px; background: #6F7A8A; }  // Cα
                        Rectangle { x: 16px; y: 6px; width: 4px; height: 4px; border-radius: 2px; background: #6F7A8A; }  // C'
                        Rectangle { x: 24px; y: 6px; width: 4px; height: 4px; border-radius: 2px; background: #E05C6C; }  // O right
                        Rectangle { x: 16px; y: 0px; width: 4px; height: 4px; border-radius: 2px; background: #E05C6C; }  // O top
                        Rectangle { x: 8px; y: 10px; width: 4px; height: 4px; border-radius: 2px; background: #6F7A8A; }  // Cβ
                    }
                }

                SchemeCard {
                    scheme-id: "bfactor";
                    label: "by b-factor";
                    horizontal-stretch: 1;
                    cmd-text: root.scope-prefix + "b, " + root.target;
                    ic1: #3B82F6; ic2: #A78BFA; ic3: #EF4444;
                }
            }

            HorizontalLayout {
                spacing: 2px;
                SchemeCard {
                    scheme-id: "residue";
                    label: "by residue";
                    horizontal-stretch: 1;
                    cmd-text: root.scope-prefix + "residue, " + root.target;
                    disabled: !root.is-bio;
                    has-custom-icon: true;

                    // 5 residue-type color dots
                    Rectangle {
                        x: (parent.width - 38px) / 2;
                        width: 38px;
                        height: 8px;

                        Rectangle { x: 0px;  y: 1px; width: 6px; height: 6px; border-radius: 3px; background: #BDB091; } // hydrophobic
                        Rectangle { x: 8px;  y: 1px; width: 6px; height: 6px; border-radius: 3px; background: #7091DF; } // positive
                        Rectangle { x: 16px; y: 1px; width: 6px; height: 6px; border-radius: 3px; background: #E77D89; } // negative
                        Rectangle { x: 24px; y: 1px; width: 6px; height: 6px; border-radius: 3px; background: #7FC4CF; } // polar
                        Rectangle { x: 32px; y: 1px; width: 6px; height: 6px; border-radius: 3px; background: #E6C640; } // cysteine
                    }
                }

                SchemeCard {
                    scheme-id: "index";
                    label: "by index";
                    horizontal-stretch: 1;
                    cmd-text: root.scope-prefix + "index, " + root.target;
                    disabled: !root.is-bio;
                    ic1: #3B82F6; ic2: #22C55E; ic3: #EAB308; ic4: #EF4444;
                    has-ic4: true;
                }
            }
        }

        // Command preview footer
        HorizontalLayout {
            height: 22px;
            spacing: 0px;

            // CMD badge
            Rectangle {
                width: cmd-label.preferred-width + 2 * Spacing.sm;
                height: parent.height;
                border-radius: Shape.radius-sm;
                background: Theme.surface-raised;

                cmd-label := UiText {
                    width: 100%;
                    height: 100%;
                    text: "CMD";
                    color: Theme.text-placeholder;
                    text-style: Typography.hint;
                    font-weight: 600;
                    letter-spacing: 0.8px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Command text
            Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                border-radius: Shape.radius-sm;
                background: Theme.surface-control;

                UiText {
                    x: Spacing.sm;
                    width: parent.width - 2 * Spacing.sm;
                    height: 100%;
                    text: ObjectsState.popover-cmd-preview;
                    color: Theme.text-muted;
                    text-style: Typography.hint;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
