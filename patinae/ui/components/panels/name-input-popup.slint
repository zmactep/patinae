import { TextButton } from "../../controls/button.slint";
import { UiText } from "../../primitives/text.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { ObjectsState } from "../../states/objects-state.slint";

// ── Button row (OK / Cancel) ────────────────────────────────────────

component NameInputButton inherits TextButton { horizontal-stretch: 1; }

// ── Name input popup (rename / copy / extract) ──────────────────────

export component NameInputPopup inherits Rectangle {
    width: 240px;
    height: inner.preferred-height;
    clip: true;
    border-radius: Shape.radius-md;
    background: Theme.surface-overlay;
    border-width: Shape.hairline;
    border-color: Theme.border-subtle;

    TouchArea {}

    inner := VerticalLayout {
        padding: Spacing.md;
        spacing: Spacing.sm;

        // Title row — clicking it focuses the input
        title-row := Rectangle {
            horizontal-stretch: 1;
            height: 20px;
            background: transparent;

            UiText {
                width: parent.width;
                height: 20px;
                text: ObjectsState.name-input-title;
                color: Theme.text-secondary;
                text-style: Typography.hint;
                font-weight: 500;
                overflow: elide;
                vertical-alignment: center;
            }

            title-ta := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { input-field.focus(); }
            }
        }

        // Text input
        input-field := TextInput {
            vertical-alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            height: 30px;
            font-size: Typography.body-small.size;
            color: Theme.text-primary;
            single-line: true;
            text <=> ObjectsState.name-input-text;
            selection-background-color: Theme.accent-primary.with-alpha(0.3);
            selection-foreground-color: Theme.text-primary;

            accepted => {
                ObjectsState.name-input-confirm();
            }

            key-pressed(event) => {
                if event.text == Key.Escape {
                    ObjectsState.popover-close();
                    return accept;
                }
                return reject;
            }
        }

        // Button row
        HorizontalLayout {
            spacing: Spacing.sm;

            cancel-btn := NameInputButton {
                label: "Cancel";
                clicked => { ObjectsState.popover-close(); }
            }
            confirm-btn := NameInputButton {
                label: "OK";
                primary: true;
                clicked => { ObjectsState.name-input-confirm(); }
            }
        }
    }
}
