import { ComponentMetrics } from "../metrics.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { LayoutState } from "../../states/layout-state.slint";
import { PluginState } from "../../states/plugin-state.slint";
import { Control } from "../../controls/button.slint";
import { UiText } from "../../primitives/text.slint";

export component DockTab inherits Control {
    background: root.hovered ? Theme.surface-raised : transparent;
    width: caption.preferred-width + 2 * Spacing.sm;
    height: ComponentMetrics.tab-bar-h;
    caption := UiText {
        x: Spacing.sm; height: parent.height;
        text: root.label; text-style: Typography.label;
        color: root.tint; vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - Shape.border-stroke;
        height: Shape.border-stroke; width: parent.width;
        background: root.active ? Theme.accent-primary : transparent;
    }
}
export component DockTabBar inherits Rectangle {
    height: ComponentMetrics.tab-bar-h;
    HorizontalLayout {
        padding-left: Spacing.sm; spacing: Spacing.xs; alignment: start;
        if LayoutState.sequence-visible: DockTab {
            label: "SEQUENCE"; active: LayoutState.bottom-active-tab == 0;
            clicked => { PluginState.deactivate-placement("bottom"); LayoutState.bottom-active-tab = 0; }
        }
        if LayoutState.movie-visible: DockTab {
            label: "MOVIE"; active: LayoutState.bottom-active-tab == 1;
            clicked => { PluginState.deactivate-placement("bottom"); LayoutState.bottom-active-tab = 1; }
        }
        for tab in PluginState.bottom-tabs: DockTab {
            label: tab.title; active: tab.active;
            clicked => { LayoutState.bottom-active-tab = -1; PluginState.activate-panel(tab.id); }
        }
    }
    Rectangle {
        y: parent.height - Shape.hairline;
        height: Shape.hairline; width: parent.width; background: Theme.border-subtle;
    }
}
