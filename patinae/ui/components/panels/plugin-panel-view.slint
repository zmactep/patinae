component PluginTextAreaPane inherits Rectangle {
    in property <string> panel-id;
    in property <string> control-id;
    in property <string> label;
    in property <string> value-text;
    in property <string> placeholder;
    in property <bool> read-only;
    in property <[PluginHighlightLine]> highlight-lines;

    VerticalLayout {
        spacing: 4px;

        Text {
            visible: root.label != "";
            height: root.label == "" ? 0px : 14px;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Typography.hint.size;
        }

        HighlightedTextArea {
            vertical-stretch: 1;
            min-height: 48px;
            identity: root.control-id;
            value-text: root.value-text;
            placeholder: root.placeholder;
            read-only: root.read-only;
            highlight-lines: root.highlight-lines;
            font-family: Typography.content-family;
            font-size: Typography.compact-label.size;

            edited(text) => {
                PluginState.control-event(root.panel-id, root.control-id, "text-area-edit", text, 0, false);
            }

            committed(text) => {
                PluginState.control-event(root.panel-id, root.control-id, "text-commit", text, 0, false);
            }
        }
    }
}

component PluginLeafToggle inherits Rectangle {
    in property <PluginControlLeaf> control;
    in property <string> panel-id;

    height: 28px;

    HorizontalLayout {
        spacing: Spacing.sm;

        Rectangle {
            width: 30px;
            height: 100%;
            background: transparent;

            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 16px;
                border-radius: 8px;
                border-width: Shape.hairline;
                border-color: root.control.bool-value ? Theme.accent-primary.with-alpha(0.60) : Theme.border-strong;
                background: root.control.bool-value ? Theme.accent-primary.with-alpha(0.28) : Theme.surface-control;

                Rectangle {
                    x: root.control.bool-value ? parent.width - self.width - 2px : 2px;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.control.bool-value ? Theme.accent-primary : Theme.text-muted;
                    animate x { duration: Motion.micro; easing: ease-out; }
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            height: 100%;
            text: root.control.label;
            color: Theme.text-secondary;
            font-size: Typography.compact-label.size;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PluginState.control-event(
                root.panel-id,
                root.control.id,
                "toggle",
                "",
                0,
                !root.control.bool-value
            );
        }
    }
}

// Two roles share the "button" leaf, distinguished by id:
//  - "run": a prominent filled action button (centered, bordered).
//  - everything else: a compact, flat tool-rail row; `primary` marks the
//    active tool with a cyan fill + left accent bar. Keeps the rail compact.
component PluginLeafButton inherits Rectangle {
    in property <PluginControlLeaf> control;
    in property <string> panel-id;
    property <bool> action: root.control.id == "run";

    height: 100%;
    border-radius: Shape.radius-sm;
    background: root.action
        ? (touch.has-hover ? Theme.accent-primary.brighter(0.15) : Theme.accent-primary)
        : root.control.primary ? Theme.accent-primary.with-alpha(0.14)
        : touch.has-hover ? Theme.surface-control.with-alpha(0.6) : transparent;

    if root.control.primary && !root.action: Rectangle {
        x: 0;
        width: 2px;
        height: parent.height - 6px;
        y: 3px;
        background: Theme.accent-primary;
    }

    Text {
        x: root.action ? 0px : 10px;
        width: root.action ? parent.width : parent.width - 20px;
        height: 100%;
        text: root.control.label;
        color: root.action ? Theme.surface-base : (root.control.primary ? Theme.accent-primary : Theme.text-secondary);
        font-size: root.action ? Typography.compact-label.size : Typography.hint.size;
        font-weight: root.action || root.control.primary ? 500 : 400;
        horizontal-alignment: root.action ? center : left;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PluginState.control-event(root.panel-id, root.control.id, "click", "", 0, false);
        }
    }
}

component PluginLeafOptionChip inherits Rectangle {
    in property <PluginOption> option;
    in property <PluginControlLeaf> control;
    in property <string> panel-id;
    property <bool> selected: root.option.value == root.control.value-text;

    width: max(42px, label.preferred-width + 16px);
    height: 28px;
    border-radius: Shape.radius-sm;
    background: selected ? Theme.accent-primary.with-alpha(0.14) : touch.has-hover ? Theme.surface-control : transparent;
    border-width: Shape.hairline;
    border-color: selected ? Theme.accent-primary.with-alpha(0.55) : Theme.border-subtle;

    label := Text {
        text: root.option.label;
        color: root.selected ? Theme.accent-primary : Theme.text-muted;
        font-size: Typography.hint.size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PluginState.control-event(root.panel-id, root.control.id, "select", root.option.value, 0, false);
        }
    }
}

component PluginLeafSelect inherits VerticalLayout {
    in property <PluginControlLeaf> control;
