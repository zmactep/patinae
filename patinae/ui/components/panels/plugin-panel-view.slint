component PluginSubSelect inherits VerticalLayout {
    in property <PluginSubLeaf> control;
    in property <string> panel-id;

    spacing: 3px;
    alignment: start;

    Text {
        height: 14px;
        text: root.control.label;
        color: Theme.text-secondary;
        font-size: Typography.hint.size;
