component PluginSubToggle inherits Rectangle {
    in property <PluginSubLeaf> control;
    in property <string> panel-id;

    HorizontalLayout {
        spacing: Spacing.sm;

        Rectangle {
            width: 30px;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 16px;
                border-radius: 8px;
                border-width: Shape.hairline;
                border-color: root.control.bool-value ? Theme.accent-primary.with-alpha(0.60) : Theme.border-strong;
                background: root.control.bool-value ? Theme.accent-primary.with-alpha(0.28) : Theme.surface-control;

                Rectangle {
                    x: root.control.bool-value ? parent.width - self.width - 2px : 2px;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.control.bool-value ? Theme.accent-primary : Theme.text-muted;
                    animate x { duration: Motion.micro; easing: ease-out; }
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.control.label;
            color: Theme.text-secondary;
            font-size: Typography.compact-label.size;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PluginState.control-event(root.panel-id, root.control.id, "toggle", "", 0, !root.control.bool-value);
        }
    }
}

component PluginSubButton inherits Rectangle {
    in property <PluginSubLeaf> control;
    in property <string> panel-id;
    property <bool> action: root.control.id == "run";

    height: 100%;
    min-width: btn-label.preferred-width + (root.action ? 28px : 4px);
    border-radius: Shape.radius-sm;
    background: root.action
        ? (touch.has-hover ? Theme.accent-primary.brighter(0.15) : Theme.accent-primary)
        : touch.has-hover ? Theme.surface-control.with-alpha(0.6) : transparent;

    btn-label := Text {
        x: root.action ? 12px : 0px;
        width: parent.width - (root.action ? 24px : 0px);
        height: 100%;
        text: root.control.label;
        color: root.action ? Theme.surface-base : Theme.text-secondary;
        font-size: Typography.compact-label.size;
        font-weight: root.action ? 500 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            PluginState.control-event(root.panel-id, root.control.id, "click", "", 0, false);
        }
    }
}

component PluginSubTitleDesc inherits VerticalLayout {
    in property <PluginSubLeaf> control;

    spacing: 3px;
    alignment: start;

    Text {
        text: root.control.label;
        color: Theme.text-primary;
        font-size: Typography.compact-label.size;
        font-weight: 600;
        vertical-stretch: 0;
    }

    Text {
        text: root.control.text;
        color: Theme.text-muted;
        font-size: Typography.hint.size;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
}

component PluginSubLeafRow inherits Rectangle {
    in property <PluginSubLeaf> control;
    in property <string> panel-id;

    height: root.control.kind == "text" ? max(root.control.height * 1px, sub-text.preferred-height)
        : max(4px, root.control.height * 1px);
    // A button cell does not stretch (grow 0); give it a width so it can't
    // collapse to a thin strip when the inner button is width:100%.
    min-width: root.control.kind == "button" ? 150px : 0px;

    if control.kind == "titledesc": PluginSubTitleDesc {
        width: 100%;
        control: root.control;
    }

    if control.kind == "heading": Text {
        width: 100%;
        text: root.control.text;
        color: Theme.text-primary;
        font-size: Typography.compact-label.size;
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    sub-text := Text {
        visible: root.control.kind == "text";
        width: 100%;
        text: root.control.text;
        color: Theme.text-muted;
        font-size: Typography.hint.size;
        horizontal-alignment: left;
        wrap: word-wrap;
    }

    if control.kind == "number" || control.kind == "text-input": PluginSubTextInput {
        width: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "select": PluginSubSelect {
        width: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "toggle": PluginSubToggle {
        width: 100%;
        height: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "button": PluginSubButton {
        width: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }
}

component PluginControlLeafRow inherits Rectangle {
    in property <PluginControlLeaf> control;
    in property <string> panel-id;

    height: root.control.kind == "text" ? max(root.control.height * 1px, leaf-text.preferred-height)
        : max(4px, root.control.height * 1px);

    if control.kind == "heading": Text {
        width: 100%;
        text: root.control.text;
        color: Theme.text-primary;
        font-size: Typography.compact-label.size;
        font-weight: 600;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    leaf-text := Text {
        visible: root.control.kind == "text";
        width: 100%;
        text: root.control.text;
        color: Theme.text-muted;
        font-size: Typography.hint.size;
        horizontal-alignment: left;
        wrap: word-wrap;
    }

    if control.kind == "number": PluginLeafTextInput {
        width: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "text-input": PluginLeafTextInput {
        width: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "select": PluginLeafSelect {
        width: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "toggle": PluginLeafToggle {
        width: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "button": PluginLeafButton {
        width: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "text-area": PluginLeafTextArea {
        width: 100%;
        height: 100%;
        control: root.control;
        panel-id: root.panel-id;
    }

    if control.kind == "row": HorizontalLayout {
        spacing: root.control.gap * 1px;

        for sub in root.control.sub-children: PluginSubLeafRow {
            horizontal-stretch: sub.grow;
            height: 100%;
            control: sub;
            panel-id: root.panel-id;
        }
    }

    if control.kind == "column": VerticalLayout {
        spacing: root.control.gap * 1px;

        for sub in root.control.sub-children: PluginSubLeafRow {
            width: 100%;
            control: sub;
            panel-id: root.panel-id;
        }
    }
}

