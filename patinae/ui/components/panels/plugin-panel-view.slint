    }
}

component PluginSubTextInput inherits Rectangle {
    in property <PluginSubLeaf> control;
    in property <string> panel-id;

    VerticalLayout {
        spacing: 3px;
        alignment: start;

        Text {
            visible: root.control.label != "";
            height: root.control.label == "" ? 0px : 14px;
            text: root.control.label;
            color: Theme.text-secondary;
            font-size: Typography.hint.size;
        }

        Rectangle {
            height: 28px;
            border-radius: Shape.radius-sm;
            background: Theme.surface-control.with-alpha(0.70);
            border-width: Shape.hairline;
            border-color: input.has-focus ? Theme.accent-primary.with-alpha(0.65) : Theme.border-subtle;

            input := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.control.value-text;
                single-line: true;
                color: Theme.text-secondary;
                font-size: Typography.compact-label.size;
                vertical-alignment: center;
                selection-background-color: Theme.accent-primary.with-alpha(0.3);
                selection-foreground-color: Theme.text-primary;

                edited => {
                    PluginState.control-event(root.panel-id, root.control.id, "text-edit", self.text, 0, false);
                }
                accepted => {
                    PluginState.control-event(root.panel-id, root.control.id, "text-commit", self.text, 0, false);
                }
            }
        }
    }
}

