import { InlineName } from "../../controls/inline-name.slint";
import { UiText } from "../../primitives/text.slint";
import { ComponentMetrics } from "../metrics.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { ObjectsState, ObjectItem, SubchainItem, TopLevelRow } from "../../states/objects-state.slint";
import {
    ChevronRight,
    ChevronDown,
    BioGlyph,
    SolventGlyph,
    OrganicGlyph,
    InorganicGlyph,
    MapSourceGlyph,
    MapIsomeshGlyph,
    MapIsosurfaceGlyph,
    MeasurementDistanceGlyph,
    MeasurementAngleGlyph,
    MeasurementDihedralGlyph,
    LabelGlyph,
} from "../icons.slint";
import { RowActions } from "./row-btn.slint";

import { PanelRow } from "../../controls/panel-row.slint";
import { TooltipAnchor } from "../../controls/tooltip.slint";
export component SubchainRow inherits PanelRow {
    in property <SubchainItem> subchain;
    in property <string> obj-name;
    in property <length> base-indent;
    in property <bool> obj-enabled: true;

    property <bool> click-shift: false;
    property <bool> click-meta:  false;

    height: ComponentMetrics.chain-row-h;
    selected: root.subchain.selected;
    hovered: touch.has-hover;

    activated(shift, meta) => { ObjectsState.subchain-clicked(root.obj-name, root.subchain.chain-id,
        root.subchain.label, root.subchain.kind, root.subchain.entry-index, root.subchain.selector-clause, shift, meta); }
    // Kind indicator slot
    Rectangle {
        x: root.base-indent;
        y: 0;
        width: ComponentMetrics.chain-indicator-w;
        height: parent.height;
        background: transparent;

        if root.subchain.kind == "biopolymer": BioGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: root.obj-enabled ? root.subchain.color : Theme.text-placeholder;
            multicolor: root.obj-enabled && root.subchain.multicolor;
        }

        if root.subchain.kind == "solvent": SolventGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: root.obj-enabled ? Theme.accent-violet : Theme.text-placeholder;
        }

        if root.subchain.kind == "organic": OrganicGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: root.obj-enabled ? Theme.text-muted : Theme.text-placeholder;
        }

        if root.subchain.kind == "inorganic": InorganicGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: root.obj-enabled ? Theme.accent-selection : Theme.text-placeholder;
        }
    }

    // Chain letter (+ label suffix when present, e.g. "A (HEM)")
    chain-name := UiText {
        x: root.base-indent + ComponentMetrics.chain-indicator-w + Spacing.sm;
        width: max(0px, atom-count.x - self.x - Spacing.sm);
        overflow: elide;
        y: 0;
        height: parent.height;
        text: root.subchain.label == ""
            ? root.subchain.chain-id
            : root.subchain.chain-id + " (" + root.subchain.label + ")";
        color: !root.obj-enabled
            ? Theme.text-placeholder
            : root.subchain.selected ? Theme.text-primary : Theme.text-secondary;
        text-style: Typography.code;
        vertical-alignment: center;
    }

    // Count occupies a stable column; actions never shift the row content.
    atom-count := UiText {
        x: parent.width - self.width - Spacing.md - ComponentMetrics.row-actions-w;
        y: 0;
        height: parent.height;
        text: root.subchain.atom-count;
        color: root.obj-enabled ? Theme.text-placeholder : Theme.text-placeholder.with-alpha(0.4);
        text-style: Typography.hint;
        vertical-alignment: center;

    }

    // Click area (before RowBtns so it doesn't steal clicks)
    touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - ComponentMetrics.row-actions-w;
        height: parent.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.click-shift = event.modifiers.shift;
                root.click-meta  = event.modifiers.meta || event.modifiers.control;
            }
        }
        clicked => {
            root.focus-row();
            ObjectsState.subchain-clicked(root.obj-name, root.subchain.chain-id,
                                          root.subchain.label, root.subchain.kind,
                                          root.subchain.entry-index, root.subchain.selector-clause,
                                          root.click-shift, root.click-meta);
        }
    }

    RowActions {
        x: parent.width - self.width; y: (parent.height - self.height) / 2;
        obj-name: root.obj-name; chain-id: root.subchain.chain-id;
        subchain-label: root.subchain.label; subchain-kind: root.subchain.kind;
        entry-index: root.subchain.entry-index; selector-clause: root.subchain.selector-clause;
        row-hovered: touch.has-hover || root.focused;
    }
    TooltipAnchor { width: parent.width - ComponentMetrics.row-actions-w; height: parent.height; text: chain-name.text; active: touch.has-hover && chain-name.preferred-width > chain-name.width; }
}
export component ObjectRow inherits Rectangle {
    in property <ObjectItem> obj;
    in property <bool> in-group: false;

    property <length> indent: root.in-group ? ComponentMetrics.tree-indent : 0px;
    property <bool> can-expand: root.obj.has-representations && root.obj.subchains.length > 0;
    property <bool> has-object-icon: root.obj.object-icon-kind != "";
    property <bool> has-leading-slot: true;
    property <bool> has-row-color:
        root.obj.has-representations
        || root.obj.object-type == "measurement"
        || root.obj.object-type == "label";
    property <length> action-buttons-w: root.obj.has-representations
        ? ComponentMetrics.row-actions-w
        : root.has-row-color ? ComponentMetrics.row-actions-w : 0px;
    property <length> annotation-meta-w:
        root.obj.object-type == "measurement" || root.obj.object-type == "label" || root.obj.instanced ? 92px : 0px;

    height: ComponentMetrics.row-h;
    // Object header row
    obj-header := PanelRow {
        property <bool> click-shift: false;
        property <bool> click-meta:  false;

        height: ComponentMetrics.row-h;
    selected: root.obj.selected;
    hovered: obj-touch.has-hover || chevron-touch.has-hover;
        accessible-role: list-item;
        accessible-label: root.obj.name
            + (root.obj.instanced ? ", instanced, " + root.obj.atom-count + " displayed atoms, " + root.obj.stored-atom-count + " stored atoms" : "")
            + (root.obj.focus-disabled-reason != "" ? ". " + root.obj.focus-disabled-reason : "");

        activated(shift, meta) => { ObjectsState.object-clicked(root.obj.name, shift, meta); }
        // Chevron
        Rectangle {
            x: root.indent + Spacing.md;
            y: 0;
            width: ComponentMetrics.chevron-w;
            height: parent.height;
            visible: root.can-expand;

            if root.obj.expanded: ChevronDown {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? Theme.text-secondary : Theme.text-placeholder;
            }
            if !root.obj.expanded: ChevronRight {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? Theme.text-disabled : Theme.text-placeholder;
            }
        }

        // Object-kind icon
        Rectangle {
            x: root.indent + Spacing.md;
            y: 0;
            width: ComponentMetrics.chevron-w;
            height: parent.height;
            visible: root.has-object-icon;
            background: transparent;

            if root.obj.object-icon-kind == "map-source": MapSourceGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? Theme.accent-primary : Theme.text-placeholder;
            }

            if root.obj.object-icon-kind == "map-isomesh": MapIsomeshGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? Theme.accent-primary : Theme.text-placeholder;
            }

            if root.obj.object-icon-kind == "map-isosurface": MapIsosurfaceGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? Theme.accent-primary : Theme.text-placeholder;
            }

            if root.obj.object-icon-kind == "measurement-distance": MeasurementDistanceGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? root.obj.color : Theme.text-placeholder;
                multicolor: root.obj.enabled && root.obj.multicolor;
            }

            if root.obj.object-icon-kind == "measurement-angle": MeasurementAngleGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? root.obj.color : Theme.text-placeholder;
                multicolor: root.obj.enabled && root.obj.multicolor;
            }

            if root.obj.object-icon-kind == "measurement-dihedral": MeasurementDihedralGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? root.obj.color : Theme.text-placeholder;
                multicolor: root.obj.enabled && root.obj.multicolor;
            }

            if root.obj.object-icon-kind == "label": LabelGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.obj.enabled ? root.obj.color : Theme.text-placeholder;
                multicolor: root.obj.enabled && root.obj.multicolor;
            }
        }

        // Name
        name-text := UiText {
            x: root.indent + Spacing.md
                + (root.has-leading-slot ? ComponentMetrics.chevron-w + Spacing.sm : 0px);
            y: 0;
            width: parent.width - self.x - Spacing.md
                - root.action-buttons-w - root.annotation-meta-w;
            height: parent.height;
            text: root.obj.name;
            color: !root.obj.enabled
                ? Theme.text-placeholder
                : root.obj.selected ? Theme.text-primary : Theme.text-secondary;
            text-style: Typography.body-small;
            vertical-alignment: center;
            overflow: elide;
        }



        // Annotation entity count and unresolved warning
        if root.obj.instanced: UiText {
            x: parent.width - root.action-buttons-w - root.annotation-meta-w;
            width: root.annotation-meta-w - Spacing.sm;
            height: parent.height;
            text: root.obj.atom-count + " instanced";
            color: Theme.text-placeholder;
            text-style: Typography.hint;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.obj.object-type == "measurement" || root.obj.object-type == "label": UiText {
            x: parent.width - root.action-buttons-w - root.annotation-meta-w;
            y: 0;
            width: root.annotation-meta-w - Spacing.sm;
            height: parent.height;
            text: root.obj.entity-count + " "
                + (root.obj.object-type == "measurement"
                    ? root.obj.measurement-kind
                    : (root.obj.entity-count == 1 ? "label" : "labels"))
                + (root.obj.has-unresolved-entities ? "  !" : "");
            color: root.obj.has-unresolved-entities
                ? Theme.status-warning
                : root.obj.enabled ? Theme.text-placeholder : Theme.text-placeholder.with-alpha(0.4);
            text-style: Typography.hint;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        // Chevron click area
        chevron-touch := TouchArea {
            x: root.indent;
            y: 0;
            width: root.can-expand ? ComponentMetrics.chevron-touch-w : 0px;
            height: parent.height;
            clicked => {
                if (root.can-expand) {
                    ObjectsState.toggle-object-expand(root.obj.name);
                }
            }
        }

        // Row click area
        obj-touch := TouchArea {
            x: root.indent + (root.can-expand ? ComponentMetrics.chevron-touch-w : 0px);
            y: 0;
            width: parent.width - root.indent
                - (root.can-expand ? ComponentMetrics.chevron-touch-w : 0px)
                - root.action-buttons-w;
            height: parent.height;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    obj-header.click-shift = event.modifiers.shift;
                    obj-header.click-meta  = event.modifiers.meta || event.modifiers.control;
                    if (event.button == PointerEventButton.right) {
                        ObjectsState.object-right-clicked(root.obj.name);
                    }
                }
            }
            clicked => {
                obj-header.focus-row();
                ObjectsState.object-clicked(root.obj.name,
                                            obj-header.click-shift, obj-header.click-meta);
            }
        }

        RowActions {
            x: parent.width - self.width; y: (parent.height - self.height) / 2;
            representations: root.obj.has-representations; colors: root.has-row-color;
            obj-name: root.obj.name;
            row-hovered: obj-touch.has-hover || chevron-touch.has-hover || obj-header.focused;
        }
    }

    if ObjectsState.name-input-action == "rename" && ObjectsState.name-input-target == root.obj.name: InlineName {
        x: name-text.x; y: name-text.y; width: name-text.width; height: name-text.height;
    }
    TooltipAnchor { width: parent.width - ComponentMetrics.row-actions-w; height: parent.height; text: root.obj.name; active: obj-touch.has-hover && name-text.preferred-width > name-text.width; }
}

export component GroupRow inherits Rectangle {
    in property <TopLevelRow> data;

    property <bool> click-shift: false;
    property <bool> click-meta:  false;

    height: ComponentMetrics.row-h;
    // Group header
    group-header := PanelRow {
        activated(shift, meta) => { ObjectsState.group-clicked(root.data.group-name, shift, meta); }
        height: ComponentMetrics.row-h;
    selected: root.data.group-selected;
    hovered: group-touch.has-hover || group-chevron-touch.has-hover;

        // Chevron
        Rectangle {
            x: Spacing.md;
            y: 0;
            width: ComponentMetrics.chevron-w;
            height: parent.height;

            if root.data.group-open: ChevronDown {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.data.group-enabled ? Theme.text-secondary : Theme.text-placeholder;
            }
            if !root.data.group-open: ChevronRight {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.data.group-enabled ? Theme.text-disabled : Theme.text-placeholder;
            }
        }

        // Group name
        group-name-text := UiText {
            x: Spacing.md + ComponentMetrics.chevron-w + Spacing.sm;
            y: 0;
            width: parent.width - self.x - Spacing.md;
            height: parent.height;
            text: root.data.group-name;
            color: !root.data.group-enabled
                ? Theme.text-placeholder
                : root.data.group-selected ? Theme.text-primary : Theme.text-secondary;
            text-style: Typography.body-small;
            vertical-alignment: center;
            overflow: elide;
        }

        // Child count badge (on hover)
        if group-touch.has-hover || group-chevron-touch.has-hover: UiText {
            x: parent.width - self.width - Spacing.md;
            y: 0;
            height: parent.height;
            text: root.data.group-child-count;
            color: Theme.text-placeholder;
            text-style: Typography.hint;
            vertical-alignment: center;
        }

        // Chevron click area
        group-chevron-touch := TouchArea {
            x: 0;
            y: 0;
            width: ComponentMetrics.chevron-touch-w;
            height: parent.height;
            clicked => {
                ObjectsState.toggle-group-open(root.data.group-name);
            }
        }

        // Row click area
        group-touch := TouchArea {
            x: ComponentMetrics.chevron-touch-w;
            y: 0;
            width: parent.width - ComponentMetrics.chevron-touch-w;
            height: parent.height;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.click-shift = event.modifiers.shift;
                    root.click-meta  = event.modifiers.meta || event.modifiers.control;
                }
            }
            clicked => {
                group-header.focus-row();
                ObjectsState.group-clicked(root.data.group-name,
                                           root.click-shift, root.click-meta);
            }
        }
    }

    if ObjectsState.name-input-action == "rename" && ObjectsState.name-input-target == root.data.group-name: InlineName {
        x: group-name-text.x; width: group-name-text.width; height: parent.height;
    }
    TooltipAnchor { width: parent.width - ComponentMetrics.row-actions-w; height: parent.height; text: root.data.group-name; active: group-touch.has-hover && group-name-text.preferred-width > group-name-text.width; }
}
