import { UiIcon } from "../../primitives/icon.slint";
import { Icons } from "../../icons/icons.slint";
import { ComponentMetrics } from "../metrics.slint";
import { Typography, Theme, Spacing, Shape, Motion } from "../../foundations/foundations.slint";
import { LayoutState } from "../../states/layout-state.slint";
import { ReplState } from "../../states/repl-state.slint";
import { ViewportState } from "../../states/viewport-state.slint";
import { CompletionPopup } from "completion-popup.slint";

// ── Prompt icon — right-pointing chevron "›" ────────────────────────

component PromptIcon inherits UiIcon {
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.terminal;
}

// ── Drawer chevron — up or down arrow ───────────────────────────────

component DrawerChevronUp inherits UiIcon {
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.chevron-up;
}

component DrawerChevronDown inherits UiIcon {
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.chevron-down;
}

// Small clock icon for timing badge lines
component ClockIcon inherits UiIcon {
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    source: Icons.clock;
}

// ── Output line icons ───────────────────────────────────────────────

// Small right-pointing chevron for command echo lines
component CmdChevronIcon inherits UiIcon {
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    source: Icons.chevron-right;
}

// Checkmark for info/normal success lines
component CheckIcon inherits UiIcon {
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    source: Icons.check;
}

// Warning triangle with exclamation mark
component WarningIcon inherits UiIcon {
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    source: Icons.warning;
}

// Red X for error lines
component ErrorIcon inherits UiIcon {
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    source: Icons.x;
}

// ── Single output line ──────────────────────────────────────────────

component OutputLine inherits Rectangle {
    in property <styled-text> text;
    in property <string> plain-text;
    in property <bool> markdown;
    in property <int> heading-level;
    in property <bool> code-block;
    in property <string> kind;
    in property <bool> show-icon: true;

    background: kind == "command" || code-block ? Theme.surface-raised : transparent;
    border-radius: kind == "command" ? Shape.radius-sm : 0px;
    height: row.preferred-height;

    row := HorizontalLayout {
        padding-top: Spacing.xs;
        padding-bottom: Spacing.xs;
        padding-right: ComponentMetrics.repl-output-pad;

        // Icon cell — vertically centered by layout
        VerticalLayout {
            width: 24px;
            horizontal-stretch: 0;
            alignment: center;

            if root.show-icon && kind == "command": CmdChevronIcon { tint: Theme.text-muted; }
            if root.show-icon && kind == "timing": ClockIcon { tint: Theme.text-placeholder; }
            if root.show-icon && (kind == "info" || kind == "normal"): CheckIcon { tint: Theme.accent-primary; }
            if root.show-icon && kind == "warning": WarningIcon { tint: Theme.status-warning; }
            if root.show-icon && kind == "error": ErrorIcon { tint: Theme.status-error; }
        }

        if !root.markdown || root.heading-level > 0 || root.code-block: Text {
            horizontal-stretch: 1;
            vertical-alignment: center;
            font-size: root.heading-level > 0 ? Typography.input.size + (7 - root.heading-level) * 1px : Typography.input.size;
            font-weight: root.heading-level > 0 ? 700 : kind == "command" ? 500 : 400;
            font-family: root.code-block ? "monospace" : "";
            wrap: word-wrap;
            color: kind == "command" ? Theme.text-secondary
                 : kind == "timing"  ? Theme.text-placeholder
                 : kind == "error"   ? Theme.status-error
                 : kind == "warning" ? Theme.status-warning
                 :                     Theme.text-muted;
            text: root.plain-text;
        }
        if root.markdown && root.heading-level == 0 && !root.code-block: StyledText {
            horizontal-stretch: 1;
            vertical-alignment: center;
            default-font-size: Typography.input.size;
            default-color: kind == "command" ? Theme.text-secondary
                 : kind == "timing"  ? Theme.text-placeholder
                 : kind == "error"   ? Theme.status-error
                 : kind == "warning" ? Theme.status-warning
                 :                     Theme.text-muted;
            link-color: Theme.accent-primary;
            link-clicked(url) => { ReplState.open-link(url); }
            text: root.text;
        }
    }
}

// ── REPL pill + output drawer ───────────────────────────────────────

export component ReplPill inherits Rectangle {
    in property <length> viewport-w;
    in property <length> viewport-h;
    forward-focus: input-field;

    background: transparent;

    // Drawer state memory — saved on dismiss, restored on focus
    property <bool> drawer-was-open: false;

    // Keyboard focus scope — resting target when TextInput is unfocused.
    // Ensures Tab always works, even after layout reflows from panel toggling.
    scope := FocusScope {
        focus-on-click: false;

        key-pressed(event) => {
            if event.text == Key.Tab {
                root.focus-input();
                return accept;
            }
            return reject;
        }
    }

    function dismiss() {
        drawer-was-open = ReplState.drawer-open;
        ReplState.drawer-open = false;
        ReplState.completion-visible = false;
        ReplState.focused = false;
        input-field.clear-focus();
        scope.focus();
    }

    // Pill geometry
    property <length> pill-w: min(ComponentMetrics.repl-pill-w, max(0px, root.viewport-w - 2 * Spacing.md));
    property <length> pill-h: ComponentMetrics.repl-pill-h;
    property <length> pill-x: (root.viewport-w - pill-w) / 2;
    property <length> pill-y: ComponentMetrics.repl-pill-top;

    // Drawer geometry — full height is always computed, clip height animates
    property <length> drawer-y: root.pill-y + root.pill-h + ComponentMetrics.repl-drawer-gap;
    property <length> drawer-max-h: max(0px, min(root.viewport-h * 0.5, root.viewport-h - drawer-y - Spacing.md));
    property <length> drawer-content-h: drawer-layout.preferred-height + 2 * ComponentMetrics.repl-output-pad;
    property <length> drawer-full-h: min(drawer-content-h, drawer-max-h);
    property <length> drawer-h: ReplState.drawer-open ? drawer-full-h : 0px;

    public pure function contains-point(px: length, py: length) -> bool {
        return root.visible && px >= root.pill-x && px < root.pill-x + root.pill-w
            && ((py >= root.pill-y && py < root.pill-y + root.pill-h)
                || (ReplState.drawer-open && py >= root.drawer-y && py < root.drawer-y + root.drawer-h)
                || (ReplState.completion-visible && ReplState.completion-items.length > 0
                    && py >= completion.y && py < completion.y + completion.height));
    }

    // ── Click-outside backdrop ──────────────────────────────────
    //
    // Dismisses REPL focus on a press outside the pill. Viewport presses are
    // forwarded to the viewport: short left-clicks can select, drags rotate.
    if input-field.has-focus || ReplState.drawer-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            property <bool> over-repl-ui:
                root.contains-point(self.mouse-x, self.mouse-y);
            property <bool> forwarding-viewport-input: false;

            pointer-event(event) => {
                ViewportState.shift-held   = event.modifiers.shift;
                ViewportState.control-held = event.modifiers.control;
                ViewportState.alt-held     = event.modifiers.alt;
                ViewportState.meta-held    = event.modifiers.meta;
                if event.kind == PointerEventKind.down {
                    self.forwarding-viewport-input = !self.over-repl-ui;
                    if self.forwarding-viewport-input {
                        root.dismiss();
                        ViewportState.mouse-x = self.mouse-x / 1px;
                        ViewportState.mouse-y = self.mouse-y / 1px;
                        ViewportState.press-x = ViewportState.mouse-x;
                        ViewportState.press-y = ViewportState.mouse-y;
                        ViewportState.suppress-click = false;
                        if event.button == PointerEventButton.left   { ViewportState.left-pressed = true; }
                        if event.button == PointerEventButton.middle { ViewportState.middle-pressed = true; }
                        if event.button == PointerEventButton.right  { ViewportState.right-pressed = true; }
                    }
                }
                if event.kind == PointerEventKind.up && self.forwarding-viewport-input {
                    ViewportState.mouse-x = self.mouse-x / 1px;
                    ViewportState.mouse-y = self.mouse-y / 1px;
                    if event.button == PointerEventButton.left {
                        ViewportState.click-x = ViewportState.mouse-x;
                        ViewportState.click-y = ViewportState.mouse-y;
                        ViewportState.click-serial += 1;
                    }
                }
                if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)
                   && self.forwarding-viewport-input {
                    if event.button == PointerEventButton.left   { ViewportState.left-pressed = false; }
                    if event.button == PointerEventButton.middle { ViewportState.middle-pressed = false; }
                    if event.button == PointerEventButton.right  { ViewportState.right-pressed = false; }
                    self.forwarding-viewport-input = false;
                }
            }
            moved => {
                if self.forwarding-viewport-input {
                    ViewportState.mouse-x = self.mouse-x / 1px;
                    ViewportState.mouse-y = self.mouse-y / 1px;
                }
            }
            scroll-event(event) => {
                if !self.over-repl-ui {
                    ViewportState.scroll-delta = ViewportState.scroll-delta - event.delta-y / 1px;
                }
                return accept;
            }
        }
    }

    // Output opens below the input; hit testing uses the same geometry.
    drawer := Rectangle {
        x: root.pill-x;
        y: root.drawer-y;
        width: root.pill-w;
        height: root.drawer-h;
        clip: true;
        border-radius: Shape.radius-lg;
        background: Theme.surface-overlay;
        border-width: Shape.hairline;
        border-color: Theme.border-subtle;
        visible: ReplState.drawer-open;

        animate height { duration: Motion.base; easing: ease-in-out; }


        // Block events from passing through
        TouchArea {}

        // Content stays anchored to the top while the drawer reveals downward.
        Rectangle {
            x: 0;
            width: parent.width;
            height: root.drawer-full-h;
            y: 0px;

            flick := Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                content-height: drawer-layout.preferred-height + 2 * ComponentMetrics.repl-output-pad;
                // Scroll to bottom whenever new output arrives (generation bumps).
                // The `* 0` makes the dependency invisible to the value.
                content-y: min(0px, self.height - self.content-height)
                            + ReplState.output-generation * 0px;

                drawer-layout := VerticalLayout {
                    padding: ComponentMetrics.repl-output-pad;
                    spacing: 2px;
                    width: parent.width;

                    for item in ReplState.output-items: OutputLine {
                        width: parent.width - 2 * ComponentMetrics.repl-output-pad;
                        text: item.text;
                        plain-text: item.plain-text;
                        markdown: item.markdown;
                        heading-level: item.heading-level;
                        code-block: item.code-block;
                        kind: item.kind;
                        show-icon: item.show-icon;
                    }
                }
            }
        }
    }

    // ── Completion popup (above the output layer) ─────────────────
    completion := CompletionPopup {
        x: root.pill-x;
        width: root.pill-w;
        y: root.drawer-y;
        available-height: max(0px, root.viewport-h - root.drawer-y - Spacing.md);
    }

    // ── Pill ──────────────────────────────────────────────────────
    pill := Rectangle {
        x: root.pill-x;
        y: root.pill-y;
        width: root.pill-w;
        height: root.pill-h;
        border-radius: ComponentMetrics.repl-pill-radius;
        background: Theme.surface-control;
        border-width: Shape.hairline;
        border-color: input-field.has-focus
            ? Theme.accent-primary.with-alpha(0.6)
            : Theme.border-subtle;
        opacity: input-field.has-focus ? 1.0 : 0.55;
        clip: true;

        animate opacity { duration: Motion.base; }
        animate border-color { duration: Motion.base; }

        // Block events from passing through to viewport
        TouchArea {
            clicked => {
                root.focus-input();
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            spacing: 6px;
            alignment: stretch;

            // Prompt icon (right-pointing chevron)
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                PromptIcon {
                    tint: Theme.accent-primary;
                }
            }

            // Input viewport clips long single-line commands to the pill body.
            input-viewport := Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                height: parent.height;
                clip: true;
                background: transparent;

                property <length> scroll-margin: 8px;

                input-field := TextInput {
                    x: 0px;
                    width: max(parent.width, self.preferred-width);
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: Typography.body-small.size;
                    color: Theme.text-primary;
                    single-line: true;
                    text <=> ReplState.input-text;
                    selection-background-color: Theme.accent-primary.with-alpha(0.3);
                    selection-foreground-color: Theme.text-primary;

                    changed has-focus => {
                        ReplState.focused = self.has-focus;
                        if self.has-focus {
                            ReplState.request-keyboard-modifier-reset();
                        }
                    }

                    changed text => {
                        if self.text == "" {
                            self.x = 0px;
                        }
                    }

                    accepted => {
                        ReplState.completion-visible = false;
                        ReplState.submit(self.text);
                    }

                    edited => {
                        if ReplState.input-text != "" {
                            ReplState.completion-text-changed(ReplState.input-text);
                        } else {
                            ReplState.completion-visible = false;
                            self.x = 0px;
                        }
                    }

                    cursor-position-changed(position) => {
                        if ReplState.input-text == "" {
                            self.x = 0px;
                        } else if position.x + self.x < parent.scroll-margin {
                            self.x = min(0px, -position.x + parent.scroll-margin);
                        } else if position.x + self.x > parent.width - parent.scroll-margin - self.text-cursor-width {
                            self.x = min(
                                0px,
                                parent.width - position.x - parent.scroll-margin - self.text-cursor-width
                            );
                        }
                    }

                    key-pressed(event) => {
                        // Swallow undo/redo: Rust clears REPL text externally, but Slint
                        // keeps a private TextInput undo stack that can become stale.
                        if !event.modifiers.alt
                           && (event.modifiers.control || event.modifiers.meta)
                           && (event.text == "z" || event.text == "Z" || event.text == "y" || event.text == "Y") {
                            return accept;
                        }

                        // ── When completion popup is visible ──
                        if ReplState.completion-visible {
                            if event.text == Key.UpArrow {
                                if ReplState.completion-selected > 0 {
                                    ReplState.completion-selected -= 1;
                                } else {
                                    ReplState.completion-selected = ReplState.completion-items.length - 1;
                                }
                                completion.scroll-to-selected();
                                return accept;
                            }
                            if event.text == Key.DownArrow {
                                if ReplState.completion-selected < ReplState.completion-items.length - 1 {
                                    ReplState.completion-selected += 1;
                                } else {
                                    ReplState.completion-selected = 0;
                                }
                                completion.scroll-to-selected();
                                return accept;
                            }
                            if event.text == Key.Tab {
                                ReplState.completion-accept(ReplState.completion-selected);
                                return accept;
                            }
                            if event.text == Key.Return {
                                ReplState.completion-accept(ReplState.completion-selected);
                                return accept;
                            }
                            if event.text == Key.Escape {
                                ReplState.completion-visible = false;
                                return accept;
                            }
                        } else {
                            // ── No completion visible — normal behavior ──
                            if event.text == Key.UpArrow {
                                ReplState.history-previous();
                                return accept;
                            }
                            if event.text == Key.DownArrow {
                                ReplState.history-next();
                                return accept;
                            }
                            if event.text == Key.Escape {
                                root.dismiss();
                                return accept;
                            }
                            if event.text == Key.Tab {
                                // Trigger completion on Tab when popup is hidden
                                ReplState.completion-text-changed(ReplState.input-text);
                                return accept;
                            }
                        }
                        // Ctrl+U — clear input
                        if event.modifiers.control && event.text == "u" {
                            ReplState.input-text = "";
                            self.x = 0px;
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            // Drawer toggle button — right edge
            Rectangle {
                width: 28px;
                horizontal-stretch: 0;
                background: chevron-ta.has-hover
                    ? Theme.text-placeholder.with-alpha(0.22)
                    : transparent;
                border-radius: Shape.radius-sm;

                if ReplState.drawer-open: DrawerChevronUp {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: chevron-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                }
                if !ReplState.drawer-open: DrawerChevronDown {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    tint: chevron-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                }

                chevron-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ReplState.toggle-drawer();
                    }
                }
            }
        }


    }

    // Focus interceptor — when unfocused, route clicks through focus-input()
    // so drawer-was-open is restored. Disappears once focused, allowing
    // direct TextInput interaction (cursor positioning, selection, etc.).
    if !input-field.has-focus: Rectangle {
        x: root.pill-x;
        y: root.pill-y;
        width: root.pill-w;
        height: root.pill-h;
        background: transparent;
        TouchArea {
            clicked => { root.focus-input(); }
        }
    }

    // Placeholder text (shown when input is empty and not focused)
    if !input-field.has-focus && ReplState.input-text == "": Text {
        x: root.pill-x + 34px;
        y: root.pill-y;
        height: root.pill-h;
        text: LayoutState.mod-key == "⌘" ? "Cmd-L to focus" : LayoutState.mod-key + "-L to focus";
        color: Theme.text-placeholder;
        font-size: Typography.body-small.size;
        font-italic: true;
        vertical-alignment: center;
        opacity: 0.55;

        // Click-through to pill
        TouchArea {
            clicked => {
                root.focus-input();
            }
        }
    }

    public function dismiss-input() {
        dismiss();
    }

    public function focus-input() {
        if drawer-was-open {
            ReplState.drawer-open = true;
            drawer-was-open = false;
        }
        ReplState.focused = true;
        ReplState.request-keyboard-modifier-reset();
        input-field.focus();
    }

    public function cursor-to-end() {
        input-field.set-selection-offsets(2147483647, 2147483647);
    }
}
