export component PluginSubTitleDesc inherits VerticalLayout {
    in property <string> label;
    in property <string> text;

    spacing: 3px;
    alignment: start;

    UiText {
        text: root.label;
        color: Theme.text-primary;
        text-style: Typography.label;
        font-weight: 600;
        vertical-stretch: 0;
    }

    UiText {
        text: root.text;
        color: Theme.text-muted;
        text-style: Typography.hint;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
}
