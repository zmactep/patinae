export component PluginTextAreaPane inherits Rectangle {
    in property <string> panel-id;
    in property <string> control-id;
    in property <string> label;
    in property <string> value-text;
    in property <string> placeholder;
    in property <bool> read-only;
    in property <[PluginHighlightLine]> highlight-lines;

    VerticalLayout {
        spacing: 4px;

        UiText {
            visible: root.label != "";
            height: root.label == "" ? 0px : 14px;
            text: root.label;
            color: Theme.text-secondary;
            text-style: Typography.hint;
        }

        HighlightedTextArea {
            vertical-stretch: 1;
            min-height: 48px;
            identity: root.control-id;
            value-text: root.value-text;
            placeholder: root.placeholder;
            read-only: root.read-only;
            highlight-lines: root.highlight-lines;
            font-family: Typography.content-family;
            font-size: Typography.label.size;

            edited(text) => {
                PluginState.control-event(root.panel-id, root.control-id, "text-area-edit", text, 0, false);
            }

            committed(text) => {
                PluginState.control-event(root.panel-id, root.control-id, "text-commit", text, 0, false);
            }
        }
    }
}

export component PluginLeafSelect inherits VerticalLayout {
    in property <string> label;
    in property <[PluginOption]> options;
    in property <string> value-text;
    in property <string> control-id;
    in property <string> panel-id;

    spacing: 4px;
    alignment: start;

    UiText {
        text: root.label;
        color: Theme.text-secondary;
        text-style: Typography.hint;
        vertical-stretch: 0;
    }

    HorizontalLayout {
        spacing: Spacing.xs;
        vertical-stretch: 0;
        for option in root.options: PluginOptionChip {
            option: option;
            value-text: root.value-text;
            control-id: root.control-id;
            panel-id: root.panel-id;
        }
    }
}

export component PluginLeafTextArea inherits Rectangle {
    in property <string> control-id;
    in property <string> label;
    in property <string> value-text;
    in property <string> text;
    in property <bool> read-only;
    in property <[PluginHighlightLine]> highlight-lines;
    in property <string> panel-id;

    PluginTextAreaPane {
        width: 100%;
        height: 100%;
        panel-id: root.panel-id;
        control-id: root.control-id;
        label: root.label;
        value-text: root.value-text;
        placeholder: root.text;
        read-only: root.read-only;
        highlight-lines: root.highlight-lines;
    }
}

