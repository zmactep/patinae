import { UiText } from "../../primitives/text.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { ObjectsState } from "../../states/objects-state.slint";

// ── Menu row (handles both separators and actions via is-separator) ──

component MenuRow inherits Rectangle {
    in property <string> action;
    in property <string> label;
    in property <bool> disabled;
    in property <bool> is-separator;

    width: 100%;
    height: root.is-separator ? 9px : 28px;

    // Separator line
    sep := Rectangle {
        visible: root.is-separator;
        width: 100%;
        height: 9px;
        background: transparent;

        Rectangle {
            x: Spacing.sm;
            y: 4px;
            width: parent.width - 2 * Spacing.sm;
            height: Shape.hairline;
            background: Theme.border-subtle;
        }
    }

    // Clickable action
    action-rect := Rectangle {
        visible: !root.is-separator;
        width: 100%;
        height: 28px;
        border-radius: Shape.radius-sm;
        background: root.disabled ? transparent
            : touch.has-hover ? Theme.surface-control : transparent;
        opacity: root.disabled ? 0.4 : 1.0;

        UiText {
            x: Spacing.sm;
            y: 0;
            width: parent.width - 2 * Spacing.sm;
            height: parent.height;
            text: root.label;
            color: root.disabled ? Theme.text-placeholder
                : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            text-style: Typography.label;
            font-weight: 500;
            vertical-alignment: center;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if !root.disabled {
                    ObjectsState.overflow-action(root.action);
                }
            }
        }
    }
}

// ── Overflow menu popover ────────────────────────────────────────────

export component OverflowMenu inherits Rectangle {
    width: 184px;
    height: inner.preferred-height;
    border-radius: Shape.radius-md;
    background: Theme.surface-overlay;
    border-width: Shape.hairline;
    border-color: Theme.border-subtle;

    TouchArea {}

    inner := VerticalLayout {
        padding: Spacing.xs;
        spacing: 0px;

        for item in ObjectsState.overflow-menu-items: MenuRow {
            action: item.action;
            label: item.label;
            disabled: item.disabled;
            is-separator: item.action == "separator";
        }
    }
}
