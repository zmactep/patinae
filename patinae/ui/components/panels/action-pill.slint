import { ComponentMetrics } from "../metrics.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { ObjectsState } from "../../states/objects-state.slint";
import {
    ZoomIcon,
    OrientIcon,
    CenterIcon,
    ToggleIcon,
    OverflowIcon,
    MeasurementDistanceGlyph,
    MeasurementAngleGlyph,
    MeasurementDihedralGlyph,
    LabelGlyph,
} from "../icons.slint";

// ── Icon-only pill button ────────────────────────────────────────────

component PillButton inherits Rectangle {
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback clicked();
    out property <bool> hovered <=> touch.has-hover;
    out property <color> tint: !root.enabled
        ? Theme.text-placeholder
        : touch.has-hover ? Theme.text-primary : Theme.text-secondary;

    width: ComponentMetrics.action-btn-h;
    height: ComponentMetrics.action-btn-h;
    horizontal-stretch: 0;
    border-radius: ComponentMetrics.action-btn-radius;
    background: root.enabled && touch.has-hover
        ? Theme.surface-control.with-alpha(0.6)
        : transparent;
    opacity: root.enabled ? 1.0 : 0.4;
    accessible-role: button;
    accessible-label: root.tooltip;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    if touch.has-hover && root.tooltip != "": Rectangle {
        z: 20;
        x: (parent.width - self.width) / 2;
        y: -self.height - Spacing.sm;
        width: tooltip-text.preferred-width + 2 * Spacing.sm;
        height: 22px;
        border-radius: Shape.radius-sm;
        background: Theme.surface-overlay;
        border-width: Shape.hairline;
        border-color: Theme.border-strong;

        tooltip-text := Text {
            text: root.tooltip;
            color: Theme.text-secondary;
            font-size: Typography.compact-label.size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component MeasurementActionIcon {
    in property <string> kind;
    in property <bool> add-to: false;
    in property <color> tint;

    width: ComponentMetrics.pill-icon-size;
    height: ComponentMetrics.pill-icon-size;

    if root.kind == "distance": MeasurementDistanceGlyph {
        x: 1px;
        y: 1px;
        tint: root.tint;
    }
    if root.kind == "angle": MeasurementAngleGlyph {
        x: 1px;
        y: 1px;
        tint: root.tint;
    }
    if root.kind == "dihedral": MeasurementDihedralGlyph {
        x: 1px;
        y: 1px;
        tint: root.tint;
    }

    if root.add-to: Rectangle {
        x: 10px;
        y: 10px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.surface-overlay;

        Rectangle {
            x: 1px;
            y: 2.5px;
            width: 4px;
            height: 1px;
            background: root.tint;
        }
        Rectangle {
            x: 2.5px;
            y: 1px;
            width: 1px;
            height: 4px;
            background: root.tint;
        }
    }
}

// ── Hairline separator ───────────────────────────────────────────────

component PillSep inherits Rectangle {
    width: Shape.hairline;
    horizontal-stretch: 0;
    background: Theme.border-subtle;
}

// ── Action pill ──────────────────────────────────────────────────────

export component ActionPill inherits Rectangle {
    property <bool> recent-domain: ObjectsState.recent-operand-count > 0;
    property <bool> has-camera-actions:
        !root.recent-domain
        && (ObjectsState.action-can-focus
            || ObjectsState.action-can-orient
            || ObjectsState.action-can-center);
    width: layout.preferred-width;
    height: ComponentMetrics.action-pill-h;
    border-radius: ComponentMetrics.action-pill-radius;
    background: Theme.surface-overlay;
    border-width: Shape.hairline;
    border-color: Theme.accent-primary.with-alpha(0.5);

    // Block events from passing through to content underneath
    TouchArea {}

    // Outer glow
    Rectangle {
        x: -ComponentMetrics.action-pill-glow;
        y: -ComponentMetrics.action-pill-glow;
        width: parent.width + 2 * ComponentMetrics.action-pill-glow;
        height: parent.height + 2 * ComponentMetrics.action-pill-glow;
        border-radius: ComponentMetrics.action-pill-radius + Shape.border-stroke;
        background: transparent;
        border-width: Shape.border-stroke;
        border-color: Theme.accent-primary.with-alpha(0.08);
    }

    layout := HorizontalLayout {
        padding-left:   ComponentMetrics.action-pill-pad-h;
        padding-right:  ComponentMetrics.action-pill-pad-h;
        padding-top:    ComponentMetrics.action-pill-pad-v;
        padding-bottom: ComponentMetrics.action-pill-pad-v;
        spacing: ComponentMetrics.action-pill-spacing;

        // Count badge
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: ComponentMetrics.badge-size;
                height: ComponentMetrics.badge-size;
                border-radius: ComponentMetrics.badge-radius;
                background: Theme.accent-primary.with-alpha(0.18);
                border-width: Shape.hairline;
                border-color: Theme.accent-primary.with-alpha(0.4);

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.recent-domain
                        ? ObjectsState.recent-operand-count
                        : ObjectsState.selected-count;
                    color: Theme.accent-primary;
                    font-size: Typography.hint.size;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if root.recent-domain: PillSep {}

        if root.recent-domain: measurement-btn := PillButton {
            tooltip: "Add measurement";
            enabled: ObjectsState.recent-can-add-measurement;
            clicked => { ObjectsState.action-add-measurement(); }

            MeasurementActionIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: ObjectsState.recent-measurement-kind;
                tint: measurement-btn.tint;
            }
        }

        if root.recent-domain: measurement-to-btn := PillButton {
            tooltip: "Add measurement to…";
            enabled: ObjectsState.recent-can-add-measurement
                && ObjectsState.recent-has-measurement-targets;
            clicked => {
                ObjectsState.popover-anchor-y = measurement-to-btn.absolute-position.y;
                ObjectsState.action-add-measurement-to();
            }

            MeasurementActionIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: ObjectsState.recent-measurement-kind;
                add-to: true;
                tint: measurement-to-btn.tint;
            }
        }

        if root.recent-domain: PillSep {}

        if root.recent-domain: label-btn := PillButton {
            tooltip: "Add label";
            enabled: ObjectsState.recent-can-add-label;
            clicked => {
                ObjectsState.popover-anchor-y = label-btn.absolute-position.y;
                ObjectsState.action-add-label();
            }

            LabelGlyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: label-btn.tint;
            }
        }

        if root.has-camera-actions: PillSep {}

        // Camera cluster: zoom · orient · center
        if !root.recent-domain && ObjectsState.action-can-focus: zoom-btn := PillButton {
            tooltip: "Zoom to selection";
            clicked => { ObjectsState.action-zoom(); }
            ZoomIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: zoom-btn.tint;
            }
        }
        if !root.recent-domain && ObjectsState.action-can-orient: orient-btn := PillButton {
            tooltip: "Orient selection";
            clicked => { ObjectsState.action-orient(); }
            OrientIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: orient-btn.tint;
            }
        }
        if !root.recent-domain && ObjectsState.action-can-center: center-btn := PillButton {
            tooltip: "Center selection";
            clicked => { ObjectsState.action-center(); }
            CenterIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: center-btn.tint;
            }
        }

        // Visibility toggle (not for subchains)
        if !root.recent-domain && ObjectsState.action-can-toggle && ObjectsState.selection-level != "subchains": PillSep {}
        if !root.recent-domain && ObjectsState.action-can-toggle && ObjectsState.selection-level != "subchains": toggle-btn := PillButton {
            tooltip: "Toggle visibility";
            clicked => { ObjectsState.action-toggle(); }
            ToggleIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: toggle-btn.tint;
            }
        }

        if !root.recent-domain && ObjectsState.action-can-overflow: PillSep {}

        // Overflow
        if !root.recent-domain && ObjectsState.action-can-overflow: overflow-btn := PillButton {
            tooltip: "More actions";
            clicked => {
                ObjectsState.popover-anchor-y = overflow-btn.absolute-position.y - ComponentMetrics.action-pill-pad-v;
                ObjectsState.action-overflow();
            }
            OverflowIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: overflow-btn.tint;
            }
        }
    }
}
