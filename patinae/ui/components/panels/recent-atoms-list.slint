import { ComponentMetrics } from "../metrics.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { ObjectsState, RecentAtomItem } from "../../states/objects-state.slint";
import { AtomPickIcon, RemoveIcon } from "../icons.slint";

component RecentAtomsHeader inherits Rectangle {
    height: ComponentMetrics.tab-bar-h;
    background: transparent;

    HorizontalLayout {
        padding-left: Spacing.md;
        padding-right: Spacing.md;
        alignment: space-between;

        HorizontalLayout {
            spacing: Spacing.sm;
            alignment: start;

            Text {
                text: "RECENT ATOMS";
                color: Theme.accent-selection;
                font-size: Typography.compact-label.size;
                font-weight: 500;
                letter-spacing: 1.1px;
                vertical-alignment: center;
            }

            Text {
                text: ObjectsState.recent-atoms.length;
                color: Theme.text-placeholder;
                font-size: Typography.compact-label.size;
                vertical-alignment: center;
            }
        }

        if ObjectsState.recent-atoms.length > 0: VerticalLayout {
            alignment: center;

            Rectangle {
                width: clear-label.preferred-width + 2 * Spacing.sm;
                height: ComponentMetrics.row-btn-h;
                border-radius: Shape.radius-sm;
                background: clear-touch.has-hover ? Theme.surface-control : transparent;
                accessible-role: button;
                accessible-label: "Clear recent atoms";

                clear-label := Text {
                    text: "Clear";
                    color: clear-touch.has-hover ? Theme.text-primary : Theme.text-disabled;
                    font-size: Typography.compact-label.size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { ObjectsState.recent-atoms-clear(); }
                }
            }
        }
    }
}

component RecentAtomRowItem inherits Rectangle {
    in property <RecentAtomItem> data;

    property <bool> click-shift: false;
    property <bool> click-meta: false;

    height: ComponentMetrics.row-h;
    border-radius: Shape.radius-md;
    background: root.data.selected
        ? Theme.accent-primary.with-alpha(0.06)
        : row-touch.has-hover
            ? Theme.surface-control.with-alpha(0.5)
            : transparent;
    border-width: root.data.selected ? Shape.hairline : 0px;
    border-color: root.data.selected ? Theme.accent-primary.with-alpha(0.5) : transparent;
    accessible-role: list-item;
    accessible-label: root.data.display-path
        + (root.data.operand-position > 0 ? ", operand " + root.data.operand-position : "");

    AtomPickIcon {
        x: Spacing.md;
        y: (parent.height - self.height) / 2;
        tint: root.data.selected ? Theme.accent-primary : Theme.text-placeholder;
    }

    Text {
        x: Spacing.md + 14px + Spacing.sm;
        width: parent.width - self.x - 2 * ComponentMetrics.row-h;
        height: parent.height;
        text: root.data.display-path;
        color: root.data.selected ? Theme.text-primary : Theme.text-secondary;
        font-size: Typography.compact-body.size;
        font-weight: root.data.selected ? 500 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.data.operand-position > 0: Rectangle {
        x: parent.width - 2 * ComponentMetrics.row-h + (ComponentMetrics.row-h - ComponentMetrics.badge-size) / 2;
        y: (parent.height - self.height) / 2;
        width: ComponentMetrics.badge-size;
        height: ComponentMetrics.badge-size;
        border-radius: ComponentMetrics.badge-radius;
        background: Theme.accent-primary.with-alpha(0.18);
        border-width: Shape.hairline;
        border-color: Theme.accent-primary.with-alpha(0.4);

        Text {
            text: root.data.operand-position;
            color: Theme.accent-primary;
            font-size: Typography.hint.size;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // The row target ends before quick remove, so removal never selects it.
    row-touch := TouchArea {
        width: parent.width - ComponentMetrics.row-h;
        height: parent.height;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.click-shift = event.modifiers.shift;
                root.click-meta = event.modifiers.meta || event.modifiers.control;
            }
        }
        clicked => {
            ObjectsState.recent-atom-clicked(root.data.key,
                                             root.click-shift, root.click-meta);
        }
    }

    Rectangle {
        x: parent.width - ComponentMetrics.row-h;
        width: ComponentMetrics.row-h;
        height: parent.height;
        border-radius: Shape.radius-sm;
        background: remove-touch.has-hover ? Theme.surface-control : transparent;
        accessible-role: button;
        accessible-label: "Remove " + root.data.display-path + " from recent atoms";

        RemoveIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: remove-touch.has-hover ? Theme.text-primary : Theme.text-disabled;
        }

        remove-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { ObjectsState.recent-atom-remove-clicked(root.data.key); }
        }
    }
}

export component RecentAtomsList inherits Rectangle {
    TouchArea {
        clicked => { ObjectsState.recent-atoms-background-clicked(); }
    }

    VerticalLayout {
        RecentAtomsHeader {}

        if ObjectsState.recent-atoms.length == 0: Text {
            text: "no recent atoms yet";
            color: Theme.text-placeholder;
            font-size: Typography.hint.size;
            letter-spacing: 0.6px;
            horizontal-alignment: left;
            vertical-alignment: top;
            x: Spacing.md;
        }

        if ObjectsState.recent-atoms.length > 0: Flickable {
            vertical-stretch: 1;

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { ObjectsState.recent-atoms-background-clicked(); }
            }

            VerticalLayout {
                for item in ObjectsState.recent-atoms: Rectangle {
                    height: ComponentMetrics.row-h + ComponentMetrics.row-gap;

                    RecentAtomRowItem {
                        x: Spacing.xs;
                        width: parent.width - 2 * Spacing.xs;
                        data: item;
                    }
                }
            }
        }
    }
}
