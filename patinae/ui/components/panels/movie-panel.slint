import { UiIcon } from "../../primitives/icon.slint";
import { Icons } from "../../icons/icons.slint";
import { Control, TextButton } from "../../controls/button.slint";
import { ComponentMetrics } from "../metrics.slint";
import { UiText } from "../../primitives/text.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { MovieState, MovieLane } from "../../states/movie-state.slint";

global MovieLayout {
    out property <length> label-w: 42px;
    out property <length> lane-h: 25px;
    out property <length> toolbar-h: 40px;
    out property <length> footer-h: 32px;
}

component TransportIcon inherits UiIcon {
    in property <string> kind;
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    source: root.kind == "first" ? Icons.skip-back : root.kind == "prev" ? Icons.chevron-left
        : root.kind == "play" ? Icons.play : root.kind == "pause" ? Icons.pause
        : root.kind == "next" ? Icons.chevron-right : root.kind == "last" ? Icons.skip-forward : Icons.square;
}

component MiniButton inherits Control {
    in property <string> icon;
    width: ComponentMetrics.icon-size;
    label: root.icon;
    TransportIcon {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        kind: root.icon; tint: root.tint;
    }
}

component ToggleChip inherits TextButton { }

component FieldBox inherits Rectangle {
    in-out property <string> value;
    in property <length> field-w: 44px;
    callback accepted(string);
    callback edited;

    width: root.field-w;
    height: 24px;
    border-radius: Shape.radius-sm;
    background: Theme.surface-control.with-alpha(0.72);
    border-width: Shape.hairline;
    border-color: input.has-focus ? Theme.accent-primary.with-alpha(0.65) : Theme.border-subtle.with-alpha(0.72);

    input := TextInput {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: parent.height;
        text <=> root.value;
        single-line: true;
        color: Theme.text-secondary;
        font-family: Typography.content-family;
        font-size: Typography.label.size;
        horizontal-alignment: center;
        vertical-alignment: center;
        selection-background-color: Theme.accent-primary.with-alpha(0.3);
        selection-foreground-color: Theme.text-primary;

        edited => { root.edited(); }
        accepted => { root.accepted(self.text); }
    }
}

component StatusLabel inherits Rectangle {
    in property <string> label;

    width: label-text.preferred-width;
    height: 24px;

    label-text := UiText {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: Theme.text-muted;
        text-style: Typography.label;
        vertical-alignment: center;
    }
}

component StatusValue inherits Rectangle {
    in property <string> label;

    width: value-text.preferred-width;
    height: 24px;

    value-text := UiText {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: Theme.text-muted;
        text-style: Typography.hint;
        vertical-alignment: center;
    }
}

component TimelineLaneRow inherits Rectangle {
    in property <MovieLane> lane;

    height: MovieLayout.lane-h;
    background: transparent;

    UiText {
        x: 0px;
        y: 0px;
        width: MovieLayout.label-w;
        height: parent.height;
        text: root.lane.label;
        color: root.lane.id == "mset" ? Theme.text-muted : Theme.text-disabled;
        text-style: Typography.hint;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    track := Rectangle {
        x: MovieLayout.label-w + Spacing.sm;
        y: 4px;
        width: parent.width - self.x - Spacing.md;
        height: parent.height - 8px;
        border-radius: Shape.radius-sm;
        background: Theme.surface-control.with-alpha(0.42);

        for block in root.lane.blocks: Rectangle {
            x: parent.width * block.start-pos;
            y: 3px;
            width: max(2px, parent.width * (block.end-pos - block.start-pos));
            height: parent.height - 6px;
            border-radius: Shape.radius-sm;
            background: block.kind == "state"
                ? Theme.accent-violet.with-alpha(0.16)
                : Theme.accent-selection.with-alpha(0.16);
            border-width: Shape.hairline;
            border-color: block.kind == "state"
                ? Theme.accent-violet.with-alpha(0.32)
                : Theme.accent-selection.with-alpha(0.32);

            UiText {
                x: 6px;
                width: max(0px, parent.width - 12px);
                height: parent.height;
                text: block.label;
                color: block.kind == "state" ? Theme.text-muted : Theme.accent-selection;
                text-style: Typography.hud;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        for marker in root.lane.markers: Rectangle {
            x: parent.width * marker.pos - 4px;
            y: (parent.height - 8px) / 2;
            width: 8px;
            height: 8px;
            border-radius: 1px;
            background: marker.kind == "camera"
                ? Theme.accent-primary
                : marker.kind == "scene" ? Theme.accent-amber : Theme.accent-selection;
            transform-rotation: 45deg;
            transform-origin: { x: 4px, y: 4px };
        }

        for marker in root.lane.markers: UiText {
            x: min(parent.width - self.width, parent.width * marker.pos + 7px);
            y: 0px;
            height: parent.height;
            text: root.lane.id == "camera" ? "" : marker.label;
            color: marker.kind == "scene" ? Theme.accent-amber : Theme.accent-selection;
            text-style: Typography.hud;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

component RulerRow inherits Rectangle {
    height: 22px;

    Rectangle {
        x: MovieLayout.label-w + Spacing.sm;
        y: parent.height - 4px;
        width: parent.width - self.x - Spacing.md;
        height: Shape.hairline;
        background: Theme.border-subtle;

        for tick in MovieState.ticks: Rectangle {
            x: parent.width * tick.pos;
            y: -4px;
            width: Shape.hairline;
            height: 8px;
            background: Theme.border-strong;
        }

        for tick in MovieState.ticks: UiText {
            x: max(0px, min(parent.width - self.width, parent.width * tick.pos - self.width / 2));
            y: -18px;
            text: tick.label;
            color: Theme.text-placeholder;
            text-style: Typography.hud;
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: label-text.preferred-width + 18px;
    height: 24px;
    border-radius: Shape.radius-sm;
    background: root.enabled && touch.has-hover ? Theme.surface-control : transparent;
    border-width: Shape.hairline;
    border-color: root.enabled && touch.has-hover ? Theme.border-strong : Theme.border-subtle;
    opacity: root.enabled ? 1.0 : 0.35;

    label-text := UiText {
        text: root.label;
        color: Theme.text-muted;
        text-style: Typography.hint;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Movie panel — compact timeline for animation playback and keyframes.
export component MoviePanel inherits Rectangle {
    clip: true;
    background: Theme.surface-panel;

    property <float> playhead-pos: (MovieState.current-frame - 0.5) / max(1, MovieState.frame-count);

    VerticalLayout {
        spacing: 0px;

        // ── Transport / status ───────────────────────────────────
        Rectangle {
            height: MovieLayout.toolbar-h;
            background: transparent;

            Rectangle {
                x: Spacing.md;
                y: (parent.height - self.height) / 2;
                width: parent.width - 2 * Spacing.md;
                height: 24px;

                HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: start;

                    MiniButton { icon: "first"; clicked => { MovieState.goto-frame(1); } }
                    MiniButton { icon: "prev"; clicked => { MovieState.step-frame(-1); } }
                    MiniButton {
                        icon: MovieState.is-playing ? "pause" : "play";
                        primary: true;
                        clicked => { MovieState.toggle-play(); }
                    }
                    MiniButton { icon: "next"; clicked => { MovieState.step-frame(1); } }
                    MiniButton { icon: "last"; clicked => { MovieState.goto-frame(MovieState.frame-count); } }
                    MiniButton { icon: "stop"; clicked => { MovieState.stop(); } }

                    Rectangle { width: Spacing.sm; }

                    StatusLabel { label: "Frame"; }

                    FieldBox {
                        value <=> MovieState.frame-input;
                        field-w: 42px;
                        edited => { MovieState.frame-editing = true; }
                        accepted(text) => {
                            MovieState.frame-editing = false;
                            MovieState.set-frame(text);
                        }
                    }

                    StatusValue { label: "/ " + MovieState.frame-count; }

                    StatusLabel { label: "FPS"; }

                    FieldBox {
                        value <=> MovieState.fps;
                        field-w: 38px;
                        edited => { MovieState.fps-editing = true; }
                        accepted(text) => {
                            MovieState.fps-editing = false;
                            MovieState.set-fps(text);
                        }
                    }

                    ToggleChip {
                        label: "Loop";
                        active: MovieState.loop-enabled;
                        clicked => { MovieState.toggle-loop(); }
                    }
                    ToggleChip {
                        label: "Rock";
                        active: MovieState.rock-enabled;
                        clicked => { MovieState.toggle-rock(); }
                    }
                    ToggleChip {
                        label: "Interp";
                        active: MovieState.auto-interpolate;
                        clicked => { MovieState.toggle-auto-interpolate(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    ActionButton {
                        label: "Export";
                        clicked => { MovieState.request-export(); }
                    }
                }
            }
        }

        Rectangle { height: Shape.hairline; background: Theme.border-subtle; }

        // ── Timeline ─────────────────────────────────────────────
        timeline := Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: Theme.surface-panel;

            VerticalLayout {
                spacing: 0px;
                RulerRow {}
                for lane in MovieState.lanes: TimelineLaneRow {
                    lane: lane;
                }
            }

            playhead := Rectangle {
                x: MovieLayout.label-w + Spacing.sm
                    + (parent.width - MovieLayout.label-w - Spacing.sm - Spacing.md) * root.playhead-pos;
                y: 2px;
                width: 1px;
                height: parent.height - 4px;
                background: Theme.accent-primary;
            }

            Rectangle {
                x: playhead.x - 4px;
                y: 0px;
                width: 9px;
                height: 9px;
                border-radius: 1px;
                background: Theme.accent-primary;
                transform-rotation: 45deg;
                transform-origin: { x: 4.5px, y: 4.5px };
            }

            scrub := TouchArea {
                x: MovieLayout.label-w + Spacing.sm;
                y: 0px;
                width: parent.width - self.x - Spacing.md;
                height: parent.height;
                mouse-cursor: pointer;

                clicked => {
                    MovieState.scrub(self.mouse-x / self.width);
                }
                moved => {
                    if self.pressed {
                        MovieState.scrub(self.mouse-x / self.width);
                    }
                }
            }
        }

        Rectangle { height: Shape.hairline; background: Theme.border-subtle; }

        // ── Quick actions ────────────────────────────────────────
        Rectangle {
            height: MovieLayout.footer-h;
            background: transparent;

            HorizontalLayout {
                padding-left: Spacing.md;
                padding-right: Spacing.md;
                spacing: Spacing.sm;
                alignment: start;

                ActionButton {
                    label: "+ Camera keyframe";
                    clicked => { MovieState.store-camera-keyframe(); }
                }
                ActionButton {
                    label: "+ Scene keyframe";
                    enabled: MovieState.can-store-scene;
                    clicked => { MovieState.store-scene-keyframe(); }
                }
                ActionButton {
                    label: MovieState.target-object == ""
                        ? "+ Object keyframe"
                        : "+ " + MovieState.target-object + " keyframe";
                    enabled: MovieState.can-store-object;
                    clicked => { MovieState.store-object-keyframe(); }
                }
                ActionButton {
                    label: "Interpolate";
                    clicked => { MovieState.interpolate(); }
                }

                Rectangle { horizontal-stretch: 1; }

                UiText {
                    text: MovieState.frame-count <= 1
                        ? "single frame"
                        : "" + MovieState.frame-count + " frames";
                    color: Theme.text-placeholder;
                    text-style: Typography.hint;
                    vertical-alignment: center;
                }
            }
        }
    }
}
