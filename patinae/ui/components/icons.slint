import { UiText } from "../primitives/text.slint";
import { UiIcon } from "../primitives/icon.slint";
import { Icons } from "../icons/icons.slint";
import { ComponentMetrics } from "./metrics.slint";
import { Theme, Typography } from "../foundations/foundations.slint";
// Semantic wrappers over the shared icon catalog and scientific indicators.
//
// Used by the action pill (ZoomIcon / OrientIcon / CenterIcon / ToggleIcon /
// OverflowIcon) and by the object-list chain rows (BioGlyph / SolventGlyph /
// OrganicGlyph / InorganicGlyph).


// ── Chevron icons (object-list expand/collapse) ─────────────────────

// Right-pointing chevron (collapsed state). 8×8 box, stroke only.
export component ChevronRight inherits UiIcon {
    tint: Theme.text-muted;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.chevron-right;
}

// Down-pointing chevron (expanded state). 8×8 box, stroke only.
export component ChevronDown inherits UiIcon {
    tint: Theme.text-muted;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.chevron-down;
}

// ── Action pill icons ────────────────────────────────────────────────

// Viewfinder — 4 L-shaped corner brackets inside a centered 12×12 box.
export component ZoomIcon inherits UiIcon {
    tint: Theme.text-muted;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.zoom-in;
}

// 270° arc + arrowhead — rotation/orient affordance.
// Uses a smaller 5px radius arc centered at (8,8) to keep proportions square.
export component OrientIcon inherits UiIcon {
    tint: Theme.text-muted;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.rotate-3d;
}

// Crosshair in a ring — center / recenter action. 12×12 target centered in 16×16.
export component CenterIcon inherits UiIcon {
    tint: Theme.text-muted;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.focus;
}

// Power — circle with a gap at top and a vertical stroke through the gap.
export component ToggleIcon inherits UiIcon {
    tint: Theme.text-muted;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.eye;
}

// Three horizontal dots — overflow / more-actions affordance.
export component OverflowIcon inherits UiIcon {
    tint: Theme.text-muted;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.ellipsis;
}

// Atom centered in a four-corner picking reticle.
export component AtomPickIcon inherits UiIcon {
    tint: Theme.accent-selection;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.crosshair;
}

// Small close/remove glyph for row-local destructive actions.
export component RemoveIcon inherits UiIcon {
    tint: Theme.text-disabled;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.x;
}

// ── Chain kind indicators (object-list chain sub-rows) ──────────────

// Biopolymer — chain color dot.
export component BioGlyph {
    in property <color> tint;
    in property <bool> multicolor: false;

    width: ComponentMetrics.dot-size;
    height: ComponentMetrics.dot-size;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: ComponentMetrics.dot-radius;
        background: root.multicolor
            ? @linear-gradient(135deg, #22D3EE 0%, #A78BFA 50%, #FB923C 100%)
            : root.tint;
    }
}

// Solvent — "SOL" text tag in violet.
export component SolventGlyph {
    in property <color> tint: Theme.accent-violet;

    width: ComponentMetrics.chain-indicator-w;
    height: 12px;

    UiText {
        width: 100%;
        height: 100%;
        text: "SOL";
        color: tint;
        text-style: Typography.hud;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Organic — three gray dots in a water-like triangle, connected by lines.
export component OrganicGlyph inherits UiIcon {
    tint: Theme.text-muted;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.atom;
}

// Inorganic — rotated magenta square (diamond), suggesting crystalline/ion.
export component InorganicGlyph inherits UiIcon {
    tint: Theme.accent-selection;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.diamond;
}

// Source map — small volume/grid square.
export component MapSourceGlyph inherits UiIcon {
    tint: Theme.accent-primary;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.grid-3x3;
}

// Isomesh — contour wire.
export component MapIsomeshGlyph inherits UiIcon {
    tint: Theme.accent-primary;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.waves;
}

// Isosurface — filled contour surface.
export component MapIsosurfaceGlyph inherits UiIcon {
    tint: Theme.accent-primary;
    width: ComponentMetrics.row-action-icon-size;
    height: self.width;
    source: Icons.box;
}

// Distance measurement — dashed segment with endpoint dots.
export component MeasurementDistanceGlyph {
    in property <color> tint: Theme.accent-primary;
    in property <bool> multicolor: false;
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    UiIcon { width: parent.width; height: parent.height; source: Icons.ruler; tint: root.tint; }
    if root.multicolor: Rectangle {
        x: parent.width - self.width; y: parent.height - self.height;
        width: ComponentMetrics.marker-inner; height: self.width; border-radius: self.width / 2;
        background: @linear-gradient(90deg, Theme.accent-primary 0%, Theme.accent-selection 100%);
    }
}

// Angle measurement — two legs and an inner arc.
export component MeasurementAngleGlyph {
    in property <color> tint: Theme.accent-primary;
    in property <bool> multicolor: false;
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    UiIcon { width: parent.width; height: parent.height; source: Icons.triangle; tint: root.tint; }
    if root.multicolor: Rectangle {
        x: parent.width - self.width; y: parent.height - self.height;
        width: ComponentMetrics.marker-inner; height: self.width; border-radius: self.width / 2;
        background: @linear-gradient(90deg, Theme.accent-primary 0%, Theme.accent-selection 100%);
    }
}

// Dihedral measurement — skewed four-point chain with a signed arc.
export component MeasurementDihedralGlyph {
    in property <color> tint: Theme.accent-primary;
    in property <bool> multicolor: false;
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    UiIcon { width: parent.width; height: parent.height; source: Icons.rotate-3d; tint: root.tint; }
    if root.multicolor: Rectangle {
        x: parent.width - self.width; y: parent.height - self.height;
        width: ComponentMetrics.marker-inner; height: self.width; border-radius: self.width / 2;
        background: @linear-gradient(90deg, Theme.accent-primary 0%, Theme.accent-selection 100%);
    }
}

// Text label collection — compact tag with two text strokes.
export component LabelGlyph {
    in property <color> tint: Theme.accent-primary;
    in property <bool> multicolor: false;
    width: ComponentMetrics.row-action-icon-size; height: self.width;
    UiIcon { width: parent.width; height: parent.height; source: Icons.tags; tint: root.tint; }
    if root.multicolor: Rectangle {
        x: parent.width - self.width; y: parent.height - self.height;
        width: ComponentMetrics.marker-inner; height: self.width; border-radius: self.width / 2;
        background: @linear-gradient(90deg, Theme.accent-primary 0%, Theme.accent-selection 100%);
    }
}
