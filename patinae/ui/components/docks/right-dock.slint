import { BuiltinPanels } from "../panels/builtin-panels.slint";
import { DockTab } from "../panels/dock-tab-bar.slint";
import { UiText } from "../../primitives/text.slint";
import { Surface } from "../../primitives/surface.slint";
import { ComponentMetrics } from "../metrics.slint";
import { Theme, Typography, Spacing, Shape } from "../../foundations/foundations.slint";
import { LayoutState } from "../../states/layout-state.slint";
import { ObjectsState } from "../../states/objects-state.slint";
import { PluginState } from "../../states/plugin-state.slint";
import { ActionPill } from "../panels/action-pill.slint";
import { PluginPanelView } from "../panels/plugin-panel-view.slint";

// Right dock — hosts built-in panels with action pill overlay.
export component RightDock inherits Surface {
    clip: true;
    level: panel;

    property <bool> builtins-visible:
        !LayoutState.empty-mode
        && (LayoutState.objects-visible
            || LayoutState.selections-visible
            || LayoutState.recent-atoms-visible);
    property <bool> has-actions: ObjectsState.selected-count > 0 || ObjectsState.recent-operand-count > 0;

    VerticalLayout {
        x: 0px; y: 0px; width: root.width;
        height: max(0px, root.height - (root.has-actions ? ComponentMetrics.action-pill-h + 2 * Spacing.sm : 0px));
        if root.builtins-visible: Rectangle {
            clip: true;
            height: PluginState.right-visible ? 50% : 100%;
            BuiltinPanels {
                width: parent.width;
                height: parent.height;
            }
        }

        if root.builtins-visible && PluginState.right-visible: Rectangle {
            height: Shape.hairline;
            background: Theme.border-subtle;
        }

        if PluginState.right-visible: Rectangle {
            clip: true;
            height: root.builtins-visible ? 50% : 100%;

            VerticalLayout {
                if PluginState.right-tabs.length > 1: HorizontalLayout {
                    height: ComponentMetrics.tab-bar-h;
                    padding-left: Spacing.md;
                    spacing: Spacing.md;

                    for tab in PluginState.right-tabs: DockTab {
                        label: tab.title; active: tab.active;
                        clicked => { PluginState.activate-panel(tab.id); }
                    }
                }

                PluginPanelView {
                    vertical-stretch: 1;
                    panel-id: PluginState.active-right-panel-id;
                    controls: PluginState.active-right-controls;
                }
            }
        }
    }

    // Action pill overlay — docked at the bottom, centered horizontally.
    if ObjectsState.selected-count > 0 || ObjectsState.recent-operand-count > 0: ActionPill {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - ComponentMetrics.action-pill-bottom-gap;
    }
}
