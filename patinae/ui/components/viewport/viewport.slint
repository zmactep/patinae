import { Hud } from "hud.slint";
import { EmptyState } from "empty-state.slint";
import { Theme } from "../../theme.slint";
import { LayoutState } from "../../states/layout-state.slint";
import { ViewportState } from "../../states/viewport-state.slint";

export component Viewport inherits Rectangle {
    background: Theme.viewport-bg;

    if !LayoutState.empty-mode: Image {
        source: ViewportState.viewport-texture;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }

    if !LayoutState.empty-mode: Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        clip: true;
        for label in ViewportState.labels: Rectangle {
            x: label.x * 1px - self.width * label.anchor-x;
            y: label.y * 1px - self.height * label.anchor-y;
            width: label-text.preferred-width;
            height: label-text.preferred-height;
            background: transparent;
            property <bool> active: ViewportState.manipulation-owner == label.owner-id
                && ViewportState.manipulation-entity == label.insertion-ordinal;
            init => { ViewportState.label-size(label.owner-id, label.insertion-ordinal, self.width / 1px, self.height / 1px); }
            changed width => { ViewportState.label-size(label.owner-id, label.insertion-ordinal, self.width / 1px, self.height / 1px); }
            changed height => { ViewportState.label-size(label.owner-id, label.insertion-ordinal, self.width / 1px, self.height / 1px); }
            property <string> identity: label.owner-id + "/" + label.insertion-ordinal;
            changed identity => { ViewportState.label-size(label.owner-id, label.insertion-ordinal, self.width / 1px, self.height / 1px); }
            if ViewportState.manipulation-visible: Rectangle {
                x: -3px; y: -2px;
                width: parent.width + 6px; height: parent.height + 4px;
                border-radius: 3px;
                border-width: parent.active ? 2px : 1px;
                border-color: parent.active ? #67e8f9 : #67e8f980;
                background: parent.active ? #164e6380 : #164e6330;
            }
            label-text := Text {
                text: label.text;
                color: label.color;
                font-size: label.size * 1px;
            }
        }

    }

    if !LayoutState.empty-mode: Hud {
        x: parent.width - self.width - 16px;
        y: 16px;
    }

    if LayoutState.empty-mode: EmptyState {
        width: parent.width;
        height: parent.height;
    }

    if !LayoutState.empty-mode: TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: ViewportState.manipulation-cursor == 2 ? grabbing : ViewportState.manipulation-cursor == 1 ? grab : default;
        property <bool> left-press-started: false;

        pointer-event(event) => {
            if event.button == PointerEventButton.left || event.kind == PointerEventKind.cancel {
                ViewportState.manipulation-pointer(event.kind == PointerEventKind.down ? 0 : event.kind == PointerEventKind.up ? 2 : 3,
                    self.mouse-x / 1px, self.mouse-y / 1px);
            }

            if event.kind == PointerEventKind.down {
                ViewportState.mouse-x = self.mouse-x / 1px;
                ViewportState.mouse-y = self.mouse-y / 1px;
                ViewportState.press-x = ViewportState.mouse-x;
                ViewportState.press-y = ViewportState.mouse-y;
                if event.button == PointerEventButton.left {
                    self.left-press-started = true;
                    ViewportState.left-pressed = true;
                }
                if event.button == PointerEventButton.middle { ViewportState.middle-pressed = true; }
                if event.button == PointerEventButton.right  { ViewportState.right-pressed = true; }
            }
            if event.kind == PointerEventKind.up {
                ViewportState.mouse-x = self.mouse-x / 1px;
                ViewportState.mouse-y = self.mouse-y / 1px;
                if event.button == PointerEventButton.left && self.left-press-started {
                    ViewportState.click-x = ViewportState.mouse-x;
                    ViewportState.click-y = ViewportState.mouse-y;
                    ViewportState.click-serial += 1;
                }
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                if event.button == PointerEventButton.left {
                    self.left-press-started = false;
                    ViewportState.left-pressed = false;
                }
                if event.button == PointerEventButton.middle { ViewportState.middle-pressed = false; }
                if event.button == PointerEventButton.right  { ViewportState.right-pressed = false; }
            }
            ViewportState.shift-held   = event.modifiers.shift;
            ViewportState.control-held = event.modifiers.control;
            ViewportState.alt-held     = event.modifiers.alt;
            ViewportState.meta-held    = event.modifiers.meta;
        }

        moved => {
            ViewportState.manipulation-pointer(1, self.mouse-x / 1px, self.mouse-y / 1px);
            ViewportState.mouse-x = self.mouse-x / 1px;
            ViewportState.mouse-y = self.mouse-y / 1px;
        }

        scroll-event(event) => {
            ViewportState.scroll-delta = ViewportState.scroll-delta - event.delta-y / 1px;
            return accept;
        }
    }
}
