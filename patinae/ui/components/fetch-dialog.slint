import { TextButton, IconButton } from "../controls/button.slint";
import { Icons } from "../icons/icons.slint";
import { Theme, Typography, Spacing, Shape } from "../foundations/foundations.slint";
import { MenuState } from "../states/menu-state.slint";

component DialogButton inherits TextButton { }

component CloseButton inherits IconButton { icon: Icons.x; label: "Close"; }

component FieldBox inherits Rectangle {
    in property <string> label;
    in property <string> helper;
    in property <bool> emphasis: false;
    in-out property <string> value;
    callback accepted();
    callback edited(string);

    horizontal-stretch: 0;
    height: 66px;
    background: transparent;

    VerticalLayout {
        spacing: 5px;

        HorizontalLayout {
            height: 18px;
            spacing: Spacing.sm;

            Text {
                text: root.label;
                color: Theme.text-muted;
                font-size: Typography.label.size;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: root.helper;
                color: Theme.text-disabled;
                font-size: Typography.hint.size;
                vertical-alignment: center;
            }
        }

        field := Rectangle {
            height: 38px;
            border-radius: Shape.radius-sm;
            border-width: input.has-focus ? 1px : Shape.hairline;
            border-color: input.has-focus ? Theme.accent-primary-strong : Theme.border-strong;
            background: input.has-focus ? Theme.surface-control : Theme.surface-raised.with-alpha(0.54);
            clip: true;

            input := TextInput {
                x: Spacing.sm;
                y: 0px;
                width: parent.width - 2 * Spacing.sm;
                height: parent.height;
                text <=> root.value;
                color: Theme.text-primary;
                font-family: root.emphasis ? Typography.content-family : Typography.interface-family;
                font-size: root.emphasis ? 18px : 13px;
                vertical-alignment: center;
                selection-background-color: Theme.accent-primary.with-alpha(0.3);
                accepted => { root.accepted(); }
                edited => { root.edited(root.value); }
            }
        }
    }
}

component FormatSegment inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <length> segment-width: 118px;
    property <bool> active: MenuState.fetch-format == value;

    width: segment-width;
    height: 34px;
    border-radius: Shape.radius-sm;
    border-width: Shape.hairline;
    border-color: active ? Theme.accent-primary-strong : (touch.has-hover ? Theme.border-strong : Theme.border-subtle);
    background: active
        ? Theme.accent-primary.with-alpha(0.15)
        : (touch.has-hover ? Theme.surface-control : Theme.surface-raised.with-alpha(0.52));

    Text {
        text: root.label;
        color: root.active ? Theme.accent-primary : Theme.text-muted;
        font-size: Typography.body-small.size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { MenuState.fetch-format-selected(root.value); }
    }
}

component FormatBox inherits Rectangle {
    horizontal-stretch: 0;
    height: 58px;
    background: transparent;

    VerticalLayout {
        spacing: 5px;

        Text {
            height: 18px;
            text: "Format";
            color: Theme.text-muted;
            font-size: Typography.label.size;
            vertical-alignment: center;
        }

        HorizontalLayout {
            height: 34px;
            spacing: Spacing.sm;

            FormatSegment {
                segment-width: (root.width - 2 * Spacing.sm) / 3;
                value: "cif";
                label: "mmCIF";
            }

            FormatSegment {
                segment-width: (root.width - 2 * Spacing.sm) / 3;
                value: "pdb";
                label: "PDB";
            }

            FormatSegment {
                segment-width: (root.width - 2 * Spacing.sm) / 3;
                value: "bcif";
                label: "BinaryCIF";
            }
        }
    }
}

component MetadataRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> link: false;
    callback clicked();

    height: 20px;
    background: transparent;

    HorizontalLayout {
        spacing: Spacing.sm;

        Text {
            width: 82px;
            horizontal-stretch: 0;
            text: root.label;
            color: Theme.text-disabled;
            font-size: Typography.label.size;
            vertical-alignment: center;
        }

        if !root.link: Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.text-muted;
            font-size: Typography.label.size;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        if root.link: Rectangle {
            horizontal-stretch: 0;
            width: link-text.preferred-width;
            height: parent.height;
            background: transparent;

            link-text := Text {
                text: root.value;
                color: link-touch.has-hover ? Theme.accent-primary : Theme.accent-primary-strong;
                font-size: Typography.label.size;
                vertical-alignment: center;
            }

            link-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.clicked(); }
            }
        }
    }
}

component MetadataPreview inherits Rectangle {
    in property <bool> loading;
    in property <string> status;
    in property <string> title;
    in property <string> method;
    in property <string> deposit-date;
    in property <string> release-date;
    in property <string> doi;

    horizontal-stretch: 0;
    height: 160px;
    border-radius: Shape.radius-sm;
    border-width: Shape.hairline;
    border-color: Theme.border-subtle;
    background: Theme.surface-control;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: root.status != "" ? Theme.status-warning : Theme.accent-primary-strong;
    }

    VerticalLayout {
        x: Spacing.md;
        y: Spacing.md;
        width: parent.width - 2 * Spacing.md;
        height: parent.height - 2 * Spacing.md;
        spacing: Spacing.xs;

        Text {
            text: root.loading
                ? "Looking up metadata..."
                : (root.status != ""
                    ? root.status
                    : (root.title != "" ? root.title : "Metadata preview"));
            color: root.status != ""
                ? Theme.status-warning
                : (root.title == "" && !root.loading ? Theme.text-muted : Theme.text-primary);
            font-size: Typography.body-small.size;
            font-weight: root.title != "" ? 600 : 400;
            wrap: word-wrap;
            height: 42px;
        }

        if root.loading: Text {
            text: "RCSB metadata request in progress";
            color: Theme.text-disabled;
            font-size: Typography.label.size;
        }

        if !root.loading && root.status != "": Text {
            text: "Fetch remains available.";
            color: Theme.text-disabled;
            font-size: Typography.label.size;
        }

        if !root.loading && root.status == "" && root.title == "": Text {
            text: "Enter a PDB ID and preview metadata.";
            color: Theme.text-disabled;
            font-size: Typography.label.size;
        }

        if !root.loading && root.status == "" && root.method != "": MetadataRow {
            label: "Method";
            value: root.method;
        }

        if !root.loading && root.status == "" && root.deposit-date != "": MetadataRow {
            label: "Deposited";
            value: root.deposit-date;
        }

        if !root.loading && root.status == "" && root.release-date != "": MetadataRow {
            label: "Released";
            value: root.release-date;
        }

        if !root.loading && root.status == "" && root.doi != "": MetadataRow {
            label: "DOI";
            value: root.doi;
            link: true;
            clicked => { MenuState.fetch-open-doi(root.doi); }
        }
    }
}

component FooterStatus inherits Rectangle {
    in property <bool> loading;
    in property <string> status;
    in property <string> title;

    horizontal-stretch: 1;
    height: 40px;
    background: transparent;

    Rectangle {
        x: 0px;
        y: 16px;
        width: 7px;
        height: 7px;
        border-radius: 4px;
        background: root.status != "" ? Theme.status-warning : Theme.accent-primary;
    }

    Text {
        x: 18px;
        y: 8px;
        width: parent.width - 18px;
        height: 24px;
        text: root.status != ""
            ? "Metadata lookup failed"
            : (root.loading
                ? "Looking up metadata"
                : (root.title != "" ? "RCSB metadata loaded" : "Ready to fetch by PDB ID"));
        color: root.status != "" ? Theme.status-warning : Theme.text-muted;
        font-size: Typography.label.size;
        vertical-alignment: center;
    }
}

export component FetchDialog inherits Rectangle {
    visible: MenuState.fetch-visible;
    background: Theme.surface-base.with-alpha(0.62);

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {}
    }

    panel := Rectangle {
        width: min(528px, parent.width - 2 * Spacing.lg);
        height: min(450px, parent.height - 2 * Spacing.lg);
        x: (parent.width - self.width) / 2;
        y: max(Spacing.lg, (parent.height - self.height) / 2);
        border-radius: Shape.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: Theme.surface-panel;

        VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.sm;

            HorizontalLayout {
                height: 34px;

                Text {
                    text: "Fetch PDB";
                    color: Theme.text-primary;
                    font-size: Typography.body.size;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                CloseButton {
                    clicked => { MenuState.fetch-close(); }
                }
            }

            form-row := Rectangle {
                horizontal-stretch: 0;
                width: panel.width - 2 * Spacing.lg;
                height: 66px;
                background: transparent;

                HorizontalLayout {
                    spacing: Spacing.md;

                    FieldBox {
                        width: (form-row.width - Spacing.md) / 2;
                        label: "PDB ID";
                        helper: "4 characters";
                        emphasis: true;
                        value <=> MenuState.fetch-pdb-id;
                        accepted => { MenuState.fetch-preview(MenuState.fetch-pdb-id); }
                        edited(value) => { MenuState.fetch-pdb-edited(value); }
                    }

                    FieldBox {
                        width: (form-row.width - Spacing.md) / 2;
                        label: "Object name";
                        helper: "optional";
                        value <=> MenuState.fetch-object-name;
                    }
                }
            }

            FormatBox {
                width: panel.width - 2 * Spacing.lg;
            }

            MetadataPreview {
                width: panel.width - 2 * Spacing.lg;
                loading: MenuState.fetch-loading;
                status: MenuState.fetch-status;
                title: MenuState.fetch-title;
                method: MenuState.fetch-method;
                deposit-date: MenuState.fetch-deposit-date;
                release-date: MenuState.fetch-release-date;
                doi: MenuState.fetch-doi;
            }

            footer-row := Rectangle {
                horizontal-stretch: 0;
                width: panel.width - 2 * Spacing.lg;
                height: 40px;
                background: transparent;

                HorizontalLayout {
                    spacing: Spacing.sm;

                    FooterStatus {
                        loading: MenuState.fetch-loading;
                        status: MenuState.fetch-status;
                        title: MenuState.fetch-title;
                    }

                    DialogButton {
                        label: "Preview";
                        enabled: !MenuState.fetch-loading;
                        clicked => { MenuState.fetch-preview(MenuState.fetch-pdb-id); }
                    }

                    DialogButton {
                        label: "Cancel";
                        clicked => { MenuState.fetch-close(); }
                    }

                    DialogButton {
                        label: "Fetch";
                        primary: true;
                        clicked => {
                            MenuState.fetch-submit(
                                MenuState.fetch-pdb-id,
                                MenuState.fetch-object-name,
                                MenuState.fetch-format
                            );
                        }
                    }
                }
            }
        }
    }
}
