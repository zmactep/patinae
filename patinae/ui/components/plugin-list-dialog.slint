import { TextButton, IconButton } from "../controls/button.slint";
import { Icons } from "../icons/icons.slint";
import { Theme, Typography, Spacing, Shape } from "../foundations/foundations.slint";
import { ScrollView } from "std-widgets.slint";
import { PluginListState } from "../states/plugin-list-state.slint";

component DialogButton inherits TextButton { }

export component PluginListDialog inherits Rectangle {
    visible: PluginListState.visible;
    background: Theme.surface-base.with-alpha(0.62);
    // Preserve the underlying keyboard focus; AppWindow captures keys while open.
    TouchArea {
        scroll-event(event) => { return accept; }
    }
    panel := Rectangle {
        width: min(600px, parent.width - 2 * Spacing.lg);
        height: min(480px, parent.height - 2 * Spacing.lg);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-panel;
        border-radius: Shape.radius-md;
        border-width: Shape.hairline;
        border-color: Theme.border-strong;
        VerticalLayout {
            padding: Spacing.lg;
            spacing: Spacing.sm;
            HorizontalLayout {
                height: 34px;
                Text {
                    text: "Plugins";
                    color: Theme.text-primary;
                    font-size: Typography.body.size;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: Icons.x; label: "Close"; clicked => { PluginListState.close(); } }
            }
            Text {
                text: PluginListState.source;
                color: Theme.text-muted;
                font-family: "monospace";
                font-size: Typography.hint.size;
                wrap: word-wrap;
            }
            if PluginListState.loading-status != "": Text {
                text: PluginListState.loading-status;
                color: Theme.text-muted;
                font-size: Typography.label.size;
            }
            ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                content-width: self.visible-width;
                VerticalLayout {
                    spacing: Spacing.sm;
                    if PluginListState.rows.length == 0: Text {
                        text: "No plugins";
                        color: Theme.text-muted;
                        font-size: Typography.body-small.size;
                    }
                    for row[index] in PluginListState.rows: Rectangle {
                        min-height: row-layout.preferred-height;
                        background: Theme.surface-control;
                        border-radius: Shape.radius-sm;
                        row-layout := HorizontalLayout {
                            padding: Spacing.sm;
                            spacing: Spacing.sm;
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: row.title + (row.missing ? " — Not loaded" : "");
                                    color: row.missing ? Theme.status-error : Theme.text-primary;
                                    font-size: Typography.body-small.size;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                if row.description != "": Text {
                                    text: row.description;
                                    color: row.missing ? Theme.status-error : Theme.text-muted;
                                    font-size: Typography.label.size;
                                    wrap: word-wrap;
                                }
                                if row.description != "": Rectangle {
                                    height: 4px;
                                }
                                Text {
                                    text: row.path;
                                    font-family: "monospace";
                                    font-size: Typography.label.size;
                                    color: row.missing ? Theme.status-error : Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: Shape.radius-sm;
                                background: trash-touch.has-hover ? Theme.status-error.with-alpha(0.12) : transparent;
                                accessible-role: button;
                                accessible-label: "Remove " + row.title;
                                accessible-action-default => { PluginListState.remove(index); }
                                Path {
                                    x: 5px; y: 5px; width: 18px; height: 18px;
                                    viewbox-width: 24; viewbox-height: 24;
                                    stroke: trash-touch.has-hover ? Theme.status-error : Theme.text-muted;
                                    stroke-width: 1.5px;
                                    fill: transparent;
                                    commands: "M 3 6 L 21 6 M 9 6 L 9 3 L 15 3 L 15 6 M 5 6 L 6 21 L 18 21 L 19 6 M 10 10 L 10 17 M 14 10 L 14 17";
                                }
                                trash-touch := TouchArea {
                                    enabled: !PluginListState.applying;
                                    mouse-cursor: pointer;
                                    clicked => { PluginListState.remove(index); }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if PluginListState.status != "": Text {
                text: PluginListState.status;
                color: PluginListState.damaged ? Theme.status-error : Theme.text-muted;
                font-size: Typography.label.size;
                wrap: word-wrap;
            }
            if PluginListState.error != "": Text {
                text: PluginListState.error;
                color: Theme.status-error;
                font-size: Typography.label.size;
                wrap: word-wrap;
            }
            HorizontalLayout {
                height: 32px;
                spacing: Spacing.sm;
                DialogButton {
                    label: "Add";
                    enabled: !PluginListState.picking && !PluginListState.applying;
                    clicked => { PluginListState.add(); }
                }
                Text {
                    text: PluginListState.dirty ? "Unsaved changes" : "";
                    color: Theme.text-muted;
                    font-size: Typography.label.size;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                DialogButton { label: "Close"; clicked => { PluginListState.close(); } }
                DialogButton {
                    label: "Save";
                    primary: true;
                    enabled: PluginListState.loading-status == "" && !PluginListState.picking && !PluginListState.applying;
                    clicked => { PluginListState.save(); }
                }
            }
        }
    }
}
