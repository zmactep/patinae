import { TooltipState } from "../states/tooltip-state.slint";
import { Theme, Typography, Spacing, Shape, Motion } from "../foundations/foundations.slint";
import { ComponentMetrics } from "../components/metrics.slint";
import { UiText } from "../primitives/text.slint";

// A passive anchor: the owning control supplies its hover state.
export component TooltipAnchor inherits Rectangle {
    in property <bool> active;
    in property <string> text;
    property <int> ticket: -1;
    changed active => {
        if root.active && root.text != "" {
            root.ticket = TooltipState.show(root.text, root.absolute-position.x,
                root.absolute-position.x + root.width,
                root.absolute-position.y, root.absolute-position.y + root.height, false);
        } else { TooltipState.release(root.ticket); }
    }
    changed absolute-position => { TooltipState.release(root.ticket); }
}

export component TooltipLayer inherits Rectangle {
    property <length> gap: Spacing.sm;
    property <length> anchor-left: TooltipState.x - root.absolute-position.x;
    property <length> anchor-right: TooltipState.right - root.absolute-position.x;
    property <length> right-space: max(0px, root.width - root.anchor-right - root.gap - Spacing.sm);
    property <length> left-space: max(0px, root.anchor-left - root.gap - Spacing.sm);
    property <length> desired-width: min(caption.preferred-width + 2 * Spacing.sm, ComponentMetrics.popover-w);
    property <bool> on-right: root.right-space >= root.desired-width
        || (root.left-space < root.desired-width && root.right-space >= root.left-space);
    property <length> anchor-center: (TooltipState.top + TooltipState.bottom) / 2 - root.absolute-position.y;
    timer := Timer {
        interval: 2 * Motion.base;
        running: TooltipState.pending;
        triggered => { TooltipState.pending = false; TooltipState.visible = TooltipState.text != ""; }
    }
    card := Rectangle {
        visible: TooltipState.visible;
        width: min(root.desired-width, root.on-right ? root.right-space : root.left-space);
        height: caption.preferred-height + 2 * Spacing.xs;
        x: root.on-right ? root.anchor-right + root.gap : root.anchor-left - root.gap - self.width;
        y: clamp(root.anchor-center - self.height / 2,
            Spacing.sm, max(Spacing.sm, root.height - self.height - Spacing.sm));
        background: Theme.accent-primary;
        border-radius: Shape.radius-sm;
        caption := UiText {
            x: Spacing.sm; y: Spacing.xs;
            width: parent.width - 2 * Spacing.sm;
            text: TooltipState.text; text-style: Typography.tooltip;
            color: Theme.text-on-accent; wrap: word-wrap;
        }
    }
    if TooltipState.visible: Path {
        width: 5px; height: 10px;
        x: root.on-right ? card.x - self.width : card.x + card.width;
        y: clamp(root.anchor-center - self.height / 2,
            card.y + Shape.radius-sm, card.y + card.height - Shape.radius-sm - self.height);
        commands: root.on-right ? "M 5 0 L 0 5 L 5 10 Z" : "M 0 0 L 5 5 L 0 10 Z";
        fill: Theme.accent-primary;
    }
}
