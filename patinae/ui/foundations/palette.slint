// Raw colors from Figma UI Colors: Light (52:0) and Dark (50:1).
// The viewport is deliberately lighter than every other Light surface.
// Only theme.slint consumes this palette.
// Light surfaces become darker as they move toward the user.
export global FoundationPalette {
    out property <color> dark-icon-disabled: #444455;
    out property <color> light-icon-disabled: #C0B898;
    out property <color> dark-text-on-accent: #0B0B10;
    out property <color> light-text-on-accent: #F5F1E6;
    out property <color> dark-surface-base: #0B0B10;
    out property <color> light-surface-base: #F5F1E6;
    out property <color> dark-surface-panel: #0E0E14;
    out property <color> light-surface-panel: #EEE9DA;
    out property <color> dark-surface-raised: #12121A;
    out property <color> light-surface-raised: #E7E1CF;
    out property <color> dark-surface-control: #15151D;
    out property <color> light-surface-control: #E1DAC5;
    out property <color> dark-surface-overlay: #191921;
    out property <color> light-surface-overlay: #DAD2BB;
    out property <color> dark-border-subtle: #1E1E28;
    out property <color> light-border-subtle: #D0C8B0;
    out property <color> dark-border-strong: #2E2E3A;
    out property <color> light-border-strong: #C0B898;
    out property <color> dark-text-primary: #B8B8C0;
    out property <color> light-text-primary: #1F1D18;
    out property <color> dark-text-secondary: #8E8E98;
    out property <color> light-text-secondary: #5A5548;
    out property <color> dark-text-muted: #8E8E98;
    out property <color> light-text-muted: #7A7568;
    out property <color> dark-text-disabled: #6D6D78;
    out property <color> light-text-disabled: #9A9488;
    out property <color> dark-text-placeholder: #3A3A43;
    out property <color> light-text-placeholder: #9A9488;
    out property <color> dark-accent-primary: #22D3EE;
    out property <color> light-accent-primary: #0E7490;
    out property <color> dark-accent-primary-strong: #0891B2;
    out property <color> light-accent-primary-strong: #155E75;
    out property <color> dark-accent-selection: #F472B6;
    out property <color> light-accent-selection: #BE185D;
    out property <color> dark-accent-selection-strong: #BE185D;
    out property <color> light-accent-selection-strong: #9D174D;
    out property <color> dark-accent-violet: #A78BFA;
    out property <color> light-accent-violet: #6D28D9;
    out property <color> dark-accent-amber: #FDE68A;
    out property <color> light-accent-amber: #B45309;
    out property <color> dark-status-error: #EF4444;
    out property <color> light-status-error: #DC2626;
    out property <color> dark-status-warning: #F59E0B;
    out property <color> light-status-warning: #D97706;
    out property <color> dark-status-success: #22C55E;
    out property <color> light-status-success: #11952E;
    out property <color> dark-surface-viewport: #0B0B0B;
    out property <color> light-surface-viewport: #FAF9F5;
}
